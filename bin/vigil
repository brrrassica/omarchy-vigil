@check
def check_dns_fallback():
    cid, cat, title = "dns-fallback", "privacy", "DNS fallback servers"
    why = ("When your DNS servers stop answering, systemd-resolved quietly sends every lookup to "
           "Google, Cloudflare or Quad9 instead. Behind a VPN that can leak where you browse.")
    if systemctl("is-active", "systemd-resolved.service") != "active":
        return result(cid, cat, title, "na", "systemd-resolved is not running.", why, weight=1)
    cfg = _resolved_config()
    if "FallbackDNS" in cfg and not cfg["FallbackDNS"].strip():
        return result(cid, cat, title, "pass", "No fallback DNS servers are used.", why, weight=1)
    value = cfg.get("FallbackDNS", "")
    return result(cid, cat, title, "warn",
                  "Fallback DNS is %s." % ("the built-in public list" if not value else clean(value, 80)), why,
                  fix=fix("terminal", "dns-fallback-off", "Remove the fallback"), weight=1)


def _nm_config():
    paths = conf_d(sys_path("/usr/lib/NetworkManager/conf.d"))
    paths.append(sys_path("/etc/NetworkManager/NetworkManager.conf"))
    paths += conf_d(sys_path("/etc/NetworkManager/conf.d"))
    return merged_ini(paths)


@check
def check_connectivity_check():
    cid, cat, title = "connectivity-check", "privacy", "Connectivity check"
    why = ("NetworkManager contacts a server every few minutes to see whether you are online. It is "
           "harmless but tells that server, and anyone watching, when your laptop is on a network.")
    if systemctl("is-active", "NetworkManager.service") != "active":
        return result(cid, cat, title, "na", "NetworkManager is not running.", why, weight=0)
    c = _nm_config().get("connectivity", {})
    if c.get("enabled", "").lower() == "false" or not c.get("uri", "").strip() or c.get("interval", "") == "0":
        return result(cid, cat, title, "pass", "The connectivity check is off.", why, weight=0)
    return result(cid, cat, title, "info", "NetworkManager checks in with %s." % clean(c.get("uri"), 80), why,
                  fix=fix("terminal", "connectivity-off", "Turn it off"), weight=0)


@check
def check_mac_randomization():
    cid, cat, title = "mac-address", "privacy", "Hardware address on Wi-Fi"
    why = ("Your Wi-Fi card's hardware (MAC) address is a permanent ID. Using a different, stable address "
           "per network stops cafés, airports and shops from recognising you across visits.")
    if systemctl("is-active", "NetworkManager.service") != "active":
        return result(cid, cat, title, "na", "NetworkManager is not running.", why, weight=1)
    nm = _nm_config()
    backend = nm.get("device", {}).get("wifi.backend", "")
    if backend == "iwd":
        try:
            iwd = parse_ini(read_text(sys_path("/etc/iwd/main.conf")) or "")
        except Refused:
            iwd = {}
        mode = iwd.get("General", {}).get("AddressRandomization", "")
        if mode in ("network", "once"):
            return result(cid, cat, title, "pass", "iwd uses a separate address per network.", why, weight=1)
        return result(cid, cat, title, "warn", "Wi-Fi uses the real hardware address.", why,
                      fix=fix("terminal", "mac-randomize", "Use a separate address per network"), weight=1)
    cloned = nm.get("connection", {}).get("wifi.cloned-mac-address", "")
    if cloned in ("stable", "random", "stable-ssid"):
        return result(cid, cat, title, "pass", "Wi-Fi uses a %s address per network." % cloned, why, weight=1)
    return result(cid, cat, title, "warn", "Wi-Fi uses the real hardware address.", why,
                  fix=fix("terminal", "mac-randomize", "Use a separate address per network"), weight=1)


@check
def check_avahi():
    cid, cat, title = "avahi", "privacy", "Network announcements (Avahi)"
    why = ("Avahi announces this computer's name and services to everyone on the local network. Finding "
           "printers keeps working with announcements switched off.")
    if systemctl("is-active", "avahi-daemon.service") != "active":
        return result(cid, cat, title, "pass", "Avahi is not running.", why, weight=1)
    try:
        conf = parse_ini(read_text(sys_path("/etc/avahi/avahi-daemon.conf")) or "")
    except Refused:
        return result(cid, cat, title, "unknown", "Could not read the Avahi settings.", why, weight=1)
    if conf.get("publish", {}).get("disable-publishing", "no").lower() == "yes":
        return result(cid, cat, title, "pass", "Avahi listens but does not announce this machine.", why, weight=1)
    return result(cid, cat, title, "warn", "This machine announces its name on the local network.", why,
                  fix=fix("terminal", "avahi-quiet", "Stop announcing"), weight=1)


def _opt_out_state():
    """('ours'|'other'|'none', detail)."""
    for parts in (OPT_OUT_DIR, (".config", "environment.d")):
        d = home_path(*parts)
        for name in list_dir(d, 200):
            try:
                text = read_text(d + "/" + name, SMALL_FILE_MAX, follow=True) or ""
            except Refused:
                continue
            if re.search(r"^\s*(export\s+)?DO_NOT_TRACK=1\b", text, re.M):
                return ("ours" if name == OPT_OUT_NAME and parts == OPT_OUT_DIR else "other"), name
    return "none", ""


@check
def check_opt_out():
    cid, cat, title = "telemetry-opt-out", "privacy", "Telemetry opt-out variables"
    why = ("Many developer tools (Homebrew, .NET, Gatsby, Next.js and others) stop sending usage data when "
           "variables such as DO_NOT_TRACK=1 are set for your session.")
    state, name = _opt_out_state()
    if state == "ours":
        return result(cid, cat, title, "pass", "Set by Vigil for every new session.", why,
                      fix=fix("helper", "optout-off", "Remove"), weight=0)
    if state == "other":
        return result(cid, cat, title, "pass", "DO_NOT_TRACK is set (%s)." % clean(name, 60), why, weight=0)
    return result(cid, cat, title, "info", "Not set.", why, fix=fix("helper", "optout-on", "Set them"), weight=0)


@check
def check_black_ops():
    cid, cat, title = "black-ops", "privacy", "Black Ops"
    why = ("Black Ops is a separate plugin that blocks telemetry from Omarchy and common apps and keeps "
           "watch that the protections stay in place. Vigil leaves the protections it manages to it.")
    if exists(home_path(".config", "omarchy", "plugins", "brightwalker25.black-ops")):
        return result(cid, cat, title, "pass", "Installed; it manages telemetry blocking.", why, weight=0)
    return result(cid, cat, title, "info", "Not installed. Vigil covers the basics; Black Ops goes further.",
                  why, weight=0)


# --- Care -------------------------------------------------------------------

def _dir_size(path, deadline):
    """Bytes under a directory, without following symlinks, within a budget."""
    total, count = 0, 0
    stack = [path]
    while stack and count < WALK_MAX_ENTRIES and time.monotonic() < deadline:
        cur = stack.pop()
        try:
            with os.scandir(cur) as it:
                for e in it:
                    count += 1
                    try:
                        if e.is_dir(follow_symlinks=False):
                            stack.append(e.path)
                        elif e.is_file(follow_symlinks=False):
                            total += e.stat(follow_symlinks=False).st_blocks * 512
                    except OSError:
                        pass
                    if count >= WALK_MAX_ENTRIES:
                        break
        except OSError:
            continue
    complete = not stack
    return total, complete


def human(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return ("%d %s" % (n, unit)) if unit == "B" else ("%.1f %s" % (n, unit))
        n /= 1024.0


def _size_check(cid, title, path, why, action, label, big):
    if not exists(path):
        return result(cid, "care", title, "pass", "Empty.", why, weight=0)
    size, complete = _dir_size(path, time.monotonic() + WALK_MAX_SECONDS)
    approx = "" if complete else "at least "
    status = "warn" if size >= big else "info"
    return result(cid, "care", title, status if size else "pass", "%s%s." % (approx, human(size)) if size else "Empty.",
                  why, fix=fix(*action, label) if size and action else None, weight=0)


@check
def check_thumbnails():
    return _size_check("thumbnails", "Thumbnail cache", home_path(".cache", "thumbnails"),
                       "Small previews of every image and video you have browsed. They can reveal files you "
                       "have since deleted.", ("helper", "clean-thumbnails"), "Clear", 512 * 1024 * 1024)


@check
def check_trash():
    return _size_check("trash", "Trash", home_path(".local", "share", "Trash"),
                       "Files you deleted from the file manager are kept here until the trash is emptied.",
                       ("helper", "empty-trash"), "Empty", 1024 * 1024 * 1024)


CACHE_UNUSED_DAYS = 7
CACHE_SKIP = {"thumbnails"}            # its own row and its own cleanup


def _cache_scan(dfd, cutoff, deadline, budget):
    """(total bytes, bytes in files unused since cutoff) below dfd, never following symlinks."""
    total = old = 0
    with os.scandir(dfd) as it:
        entries = list(it)[:max(0, budget[0])]
    for e in entries:
        budget[0] -= 1
        if budget[0] <= 0 or time.monotonic() > deadline:
            break
        try:
            if e.is_dir(follow_symlinks=False):
                sub = os.open(e.name, O_DIR, dir_fd=dfd)
                try:
                    t, o = _cache_scan(sub, cutoff, deadline, budget)
                finally:
                    os.close(sub)
                total, old = total + t, old + o
            elif e.is_file(follow_symlinks=False):
                st = e.stat(follow_symlinks=False)
                size = st.st_blocks * 512
                total += size
                if st.st_uid == os.geteuid() and max(st.st_atime, st.st_mtime) < cutoff:
                    old += size
        except OSError:
            continue
    return total, old


def _cache_cutoff():
    return time.time() - CACHE_UNUSED_DAYS * 86400


@check
def check_user_cache():
    cid, cat, title = "user-cache", "care", "Application caches"
    why = ("Browsers and apps keep caches in ~/.cache and rebuild them when needed, so this is "
           "about disk space.")
    try:
        dfd = _open_home_dir([".cache"])
    except (OSError, Refused):
        return result(cid, cat, title, "pass", "Empty.", why, weight=0)
    try:
        total = old = 0
        budget = [WALK_MAX_ENTRIES]
        deadline = time.monotonic() + WALK_MAX_SECONDS
        with os.scandir(dfd) as it:
            tops = [e.name for e in it if e.name not in CACHE_SKIP]
        for name in tops:
            try:
                st = os.stat(name, dir_fd=dfd, follow_symlinks=False)
                if stat.S_ISDIR(st.st_mode):
                    sub = os.open(name, O_DIR, dir_fd=dfd)
                    try:
                        t, o = _cache_scan(sub, _cache_cutoff(), deadline, budget)
                    finally:
                        os.close(sub)
                elif stat.S_ISREG(st.st_mode):
                    t = st.st_blocks * 512
                    o = t if st.st_uid == os.geteuid() and max(st.st_atime, st.st_mtime) < _cache_cutoff() else 0
                else:
                    continue
            except OSError:
                continue
            total, old = total + t, old + o
    finally:
        os.close(dfd)
    if not total:
        return result(cid, cat, title, "pass", "Empty.", why, weight=0)
    if old < 1024 * 1024:
        return result(cid, cat, title, "pass", "%s, all of it in use." % human(total), why, weight=0)
    return result(cid, cat, title, "warn" if old >= 5 * 1024 ** 3 else "info",
                  "%s; %s not used in the past week." % (human(total), human(old)), why,
                  fix=fix("helper", "clean-app-cache", "Clear unused"), weight=0)


_UNITS = {"B": 1, "KiB": 1024, "MiB": 1024 ** 2, "GiB": 1024 ** 3, "TiB": 1024 ** 4}
_PACCACHE_SAVED = re.compile(r"disk space saved: ([0-9]+(?:\.[0-9]+)?) (B|KiB|MiB|GiB|TiB)\)")


def _paccache_freeable():
    """Bytes `paccache -rk2` plus `paccache -ruk0` would free, from dry runs; None if unknown."""
    tool = "/usr/bin/paccache"
    if not is_trusted_executable(sys_path(tool)):
        return None
    total = 0
    for args in (["-d", "-k2"], ["-d", "-u", "-k0"]):
        rc, out = run([tool] + args + ["--nocolor"], timeout=20, limit=CMD_MAX)
        if rc != 0:
            return None
        if "no candidate packages found" in out:
            continue
        m = _PACCACHE_SAVED.search(out)
        if not m:
            return None
        total += int(float(m.group(1)) * _UNITS[m.group(2)])
    return total


@check
def check_pacman_cache():
    cid, cat, title = "pacman-cache", "care", "Package cache"
    why = ("Every package version pacman downloaded. Omarchy keeps the two newest of each so a bad update can "
           "be rolled back; Vigil keeps those and frees the rest, including packages you have since removed.")
    path = sys_path("/var/cache/pacman/pkg")
    if not exists(path):
        return result(cid, cat, title, "pass", "Empty.", why, weight=0)
    size, complete = _dir_size(path, time.monotonic() + WALK_MAX_SECONDS)
    if not size:
        return result(cid, cat, title, "pass", "Empty.", why, weight=0)
    shown = ("" if complete else "at least ") + human(size)
    free = _paccache_freeable()
    if free is None:
        return result(cid, cat, title, "unknown", "%s. Could not work out how much can be freed." % shown, why,
                      weight=0)
    if free < 1024 * 1024:
        return result(cid, cat, title, "pass", "%s, all of it kept for rollback." % shown, why, weight=0)
    return result(cid, cat, title, "warn" if free >= 2 * 1024 ** 3 else "info",
                  "%s; %s can be freed." % (shown, human(free)), why,
                  fix=fix("terminal", "clean-pacman-cache", "Free %s" % human(free)), weight=0)


@check
def check_orphans():
    cid, cat, title = "orphans", "care", "Orphaned packages"
    why = ("Packages that were installed as dependencies of something you have since removed. They still "
           "get updates and still count as installed software.")
    tool = "/usr/bin/pacman"
    if not is_trusted_executable(sys_path(tool)):
        return result(cid, cat, title, "na", "pacman is not available.", why, weight=0)
    rc, out = run([tool, "-Qdtq"], timeout=8, limit=CMD_MAX)
    if rc is None:
        return result(cid, cat, title, "unknown", "Could not list orphaned packages.", why, weight=0)
    names = out.split()
    if not names:
        return result(cid, cat, title, "pass", "None.", why, weight=0)
    return result(cid, cat, title, "info", "%d orphaned package%s." % (len(names), "" if len(names) == 1 else "s"),
                  why, clean_block(names), fix("terminal", "clean-orphans", "Review and remove"), weight=0)


@check
def check_journal():
    cid, cat, title = "journal", "care", "System logs"
    why = "The system journal keeps logs of everything that happened, which is useful but grows over time."
    tool = "/usr/bin/journalctl"
    if not is_trusted_executable(sys_path(tool)):
        return result(cid, cat, title, "na", "journalctl is not available.", why, weight=0)
    rc, out = run([tool, "--disk-usage"], timeout=6, limit=4096)
    m = re.search(r"take up ([0-9.]+[KMGT]?B?)", out or "")
    if rc is None or not m:
        return result(cid, cat, title, "unknown", "Could not read the journal size.", why, weight=0)
    return result(cid, cat, title, "info", "Logs take up %s." % clean(m.group(1), 20), why,
                  fix=fix("terminal", "clean-journal", "Keep two weeks"), weight=0)


# ---------------------------------------------------------------------------
# Undo: files in /etc that Vigil's terminal actions wrote. A file counts as
# Vigil's only while its first line is exactly ETC_MARK (Model.js writes the
# same line), so a file someone has since rewritten is never offered for undo.

ETC_MARK = "# Written by Vigil (keasbeexd.vigil). Delete this file to undo."

UNDO_FILES = {
    "undo-sysctl": "/etc/sysctl.d/90-omarchy-vigil.conf",
    "undo-llmnr": "/etc/systemd/resolved.conf.d/90-omarchy-vigil-llmnr.conf",
    "undo-dns-fallback": "/etc/systemd/resolved.conf.d/90-omarchy-vigil-fallback.conf",
    "undo-sshd": "/etc/ssh/sshd_config.d/00-omarchy-vigil.conf",
    "undo-connectivity": "/etc/NetworkManager/conf.d/90-omarchy-vigil-connectivity.conf",
    "undo-mac": "/etc/NetworkManager/conf.d/90-omarchy-vigil-mac.conf",
    "undo-protocols": "/etc/modprobe.d/90-omarchy-vigil-protocols.conf",
    "undo-firewire": "/etc/modprobe.d/90-omarchy-vigil-firewire.conf",
}
AVAHI_BACKUP = "/etc/avahi/avahi-daemon.conf.vigil-backup"

CHECK_UNDO = {
    "kernel-hardening": "undo-sysctl", "network-hardening": "undo-sysctl", "llmnr": "undo-llmnr",
    "dns-fallback": "undo-dns-fallback", "ssh-server": "undo-sshd", "connectivity-check": "undo-connectivity",
    "mac-address": "undo-mac", "avahi": "undo-avahi", "rare-protocols": "undo-protocols",
    "firewire": "undo-firewire",
}


def vigil_owned(path):
    """True when the file's first line is exactly Vigil's marker."""
    try:
        data = read_file(sys_path(path), SMALL_FILE_MAX)
    except Refused:
        return False
    if data is None:
        return False
    return data.split(b"\n", 1)[0].decode("utf-8", "replace") == ETC_MARK


def undo_available(action):
    if action == "undo-avahi":
        try:
            st = os.lstat(sys_path(AVAHI_BACKUP))
        except OSError:
            return False
        return stat.S_ISREG(st.st_mode)
    path = UNDO_FILES.get(action)
    return bool(path) and vigil_owned(path)


# Any finding that is not passing can be marked as reviewed: it stops counting
# and stays reviewed through later checks. For these, which report evidence
# (what was found, not a setting), a review covers what was found then; if
# something new turns up, the finding comes back.
EVIDENCE_CHECKS = {"open-ports", "persistence", "file-changes", "exposed-secrets", "malicious-packages",
                   "virus-scan", "ld-preload", "bumblebee", "scanner-arch-audit", "aur-status",
                   "omarchy-plugins", "aur-packages", "accounts", "shell-history", "old-services"}


def dismissible(c):
    return c["status"] not in ("pass", "na")


# ---------------------------------------------------------------------------
# State: previously seen findings and a short score history

def _state_dir():
    return _open_home_dir(list(STATE_DIR), create=True)


def _read_state(dirfd):
    try:
        fd = os.open(STATE_NAME, O_READ | os.O_NOFOLLOW, dir_fd=dirfd)
    except FileNotFoundError:
        return {}
    except OSError:
        raise Refused("state file is not a regular file")
    try:
        st = os.fstat(fd)
        if st.st_uid != os.geteuid() or st.st_nlink != 1:
            raise Refused("state file is not ours")
        raw = _read_fd(fd, STATE_FILE_MAX)
    finally:
        os.close(fd)
    try:
        data = json.loads(raw.decode("utf-8"))
    except ValueError:
        return {}
    return data if isinstance(data, dict) else {}


def write_atomic(dirfd, name, data, mode=0o600):
    tmp = ".%s.%s.tmp" % (name, secrets.token_hex(8))
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, mode, dir_fd=dirfd)
    try:
        os.fchmod(fd, mode)
        view = memoryview(data)
        while view:
            n = os.write(fd, view)
            view = view[n:]
        os.fsync(fd)
        os.rename(tmp, name, src_dir_fd=dirfd, dst_dir_fd=dirfd)
        os.fsync(dirfd)
    except BaseException:
        try:
            os.unlink(tmp, dir_fd=dirfd)
        except OSError:
            pass
        raise
    finally:
        os.close(fd)


def _lock(dirfd):
    """Serialise state read-modify-write between the panel's audits and
    dismiss/undismiss. flock on the held directory descriptor itself, so there
    is no separate lock file to plant a symlink at."""
    fcntl.flock(dirfd, fcntl.LOCK_EX)


def load_state():
    """The state file, read-only; {} when it does not exist or is not ours."""
    try:
        dirfd = _open_home_dir(list(STATE_DIR))
    except (OSError, Refused):
        return {}
    try:
        return _read_state(dirfd)
    except Refused:
        return {}
    finally:
        os.close(dirfd)


_DATE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
_FP = re.compile(r"^[a-z0-9-]{1,40}:[0-9a-f]{12}$")


def state_dismissed(state):
    """{fingerprint: date} from the state, validated and capped."""
    out = {}
    for d in state.get("dismissed", [])[:SEEN_MAX] if isinstance(state.get("dismissed"), list) else []:
        if isinstance(d, dict) and isinstance(d.get("fp"), str) and _FP.match(d["fp"]):
            at = d.get("at") if isinstance(d.get("at"), str) and _DATE.match(d.get("at")) else ""
            out[d["fp"]] = at
    return out


def state_history(state):
    """One entry per day, oldest first: [{"date", "score"}], at most HISTORY_MAX."""
    days = {}
    for h in state.get("history", []) if isinstance(state.get("history"), list) else []:
        if not isinstance(h, dict):
            continue
        at, score = h.get("at"), h.get("score")
        if not isinstance(at, str) or isinstance(score, bool) or not isinstance(score, int) or not 0 <= score <= 100:
            continue
        date = at[:10]
        if _DATE.match(date):
            days[date] = score          # later entries for the same day win
    return [{"date": d, "score": days[d]} for d in sorted(days)][-HISTORY_MAX:]


def fingerprint(c):
    """What a review covers: the check and its status, plus what was found for evidence checks."""
    basis = c["status"]
    if c["id"] in EVIDENCE_CHECKS:
        basis += "\n" + (c["detail"] or c["summary"])
    return c["id"] + ":" + hashlib.sha256(basis.encode()).hexdigest()[:12]


def update_state(report):
    """Record findings and today's score; return (new finding ids, saved)."""
    try:
        dirfd = _state_dir()
    except (OSError, Refused):
        return [], False
    try:
        _lock(dirfd)
        try:
            state = _read_state(dirfd)
        except Refused:
            return [], False
        seen = set(s for s in state.get("seen", []) if isinstance(s, str))
        dismissed = state_dismissed(state)
        current = [fingerprint(c) for c in report["checks"] if c["status"] in ("fail", "warn") and c["weight"] > 0]
        first_run = "seen" not in state
        new = [] if first_run else [f.split(":", 1)[0] for f in current if f not in seen and f not in dismissed]
        history = state_history(state)
        today = report["generatedAt"][:10]
        history = [h for h in history if h["date"] != today] + [{"date": today, "score": report["score"]}]
        out = {
            "schema": SCHEMA, "seen": current[:SEEN_MAX],
            "dismissed": [{"fp": f, "at": a} for f, a in list(dismissed.items())[-SEEN_MAX:]],
            "history": [{"at": h["date"], "score": h["score"]} for h in history[-HISTORY_MAX:]],
        }
        try:
            write_atomic(dirfd, STATE_NAME, json.dumps(out, separators=(",", ":")).encode())
        except OSError:
            return sorted(set(new))[:LIST_MAX], False
        report["history"] = history[-HISTORY_MAX:]
        return sorted(set(new))[:LIST_MAX], True
    finally:
        os.close(dirfd)


def set_dismissed(check_id, on):
    """Mark the current warning of `check_id` as reviewed, or show it again."""
    report = audit(peek=True)
    c = next((x for x in report["checks"] if x["id"] == check_id), None)
    if c is None:
        return {"ok": False, "action": "", "message": "Unknown check."}
    try:
        dirfd = _state_dir()
    except (OSError, Refused):
        return {"ok": False, "action": "", "message": "Could not open Vigil's state folder."}
    try:
        _lock(dirfd)
        try:
            state = _read_state(dirfd)
        except Refused as e:
            return {"ok": False, "action": "", "message": clean("Refused: %s" % e)}
        dismissed = state_dismissed(state)
        if on:
            if not dismissible(c):
                return {"ok": False, "action": "", "message": "This finding cannot be marked as reviewed."}
            dismissed[fingerprint(c)] = report["generatedAt"][:10]
            msg = ("Marked as reviewed. It no longer counts, and comes back only if something new is found."
                   if c["id"] in EVIDENCE_CHECKS else "Marked as reviewed. It no longer counts.")
        else:
            dismissed = {f: a for f, a in dismissed.items() if f.split(":", 1)[0] != check_id}
            msg = "Showing it again."
        state["dismissed"] = [{"fp": f, "at": a} for f, a in list(dismissed.items())[-SEEN_MAX:]]
        state["schema"] = SCHEMA
        try:
            write_atomic(dirfd, STATE_NAME, json.dumps(state, separators=(",", ":")).encode())
        except OSError:
            return {"ok": False, "action": "", "message": "Could not save."}
        return {"ok": True, "action": "", "message": msg}
    finally:
        os.close(dirfd)


# ---------------------------------------------------------------------------
# Audit

def score_of(checks):
    score = 100
    for c in checks:
        if c.get("dismissed"):
            continue
        w = c["weight"]
        if c["status"] == "fail":
            score -= 10 * w
        elif c["status"] == "warn":
            score -= 2 * w
    return max(0, min(100, score))


UNKNOWN_HOWTO = ("Vigil could not finish this check. Press R to check again; if it keeps happening, "
                 "mark it as reviewed.")

# For findings Vigil cannot fix itself: how to fix it, and a button that
# helps (a read-only command in a terminal, or a maintained guide).
CHECK_HELP = {
    "ssh-keys": ("Make ~/.ssh a normal folder owned by you, not a link, then press R.",
                 ("docs", "arch-ssh-keys", "Learn more")),
    "gnupg": ("Make ~/.gnupg a normal folder owned by you, not a link, then press R.",
              ("docs", "arch-gnupg", "Learn more")),
    "disk-encryption": ("Encryption can only be turned on when installing: back up, then reinstall Omarchy "
                        "with encryption on. If this machine never leaves home, mark it as reviewed.",
                        ("docs", "arch-dm-crypt", "Learn more")),
    "login-lockout": ("Add pam_faillock to the login rules, or set deny=3 in /etc/security/faillock.conf. "
                      "The guide shows the exact lines.", ("docs", "arch-faillock", "Learn more")),
    "open-ports": ("See which program is listening (Show listeners). Stop or uninstall what you do not "
                   "need; the firewall keeps the rest from being reached from outside.",
                   ("terminal", "show-listeners", "Show listeners")),
    "persistence": ("Open each file listed under Details and remove lines you do not recognise. If you are "
                    "not sure what a line does, ask before deleting it.", ("docs", "arch-autostart", "Learn more")),
    "ld-preload": ("If you did not set this up, look at the file (Show file). Do not delete it blindly: get "
                   "help first, because something may be hiding in every program.",
                   ("terminal", "show-ld-preload", "Show file")),
    "aur-packages": ("Keep only the ones you recognise and still use; remove the rest with "
                     "omarchy pkg drop <name>.",
                     ("docs", "arch-aur", "Learn more")),
    "virus-scan": ("Install ClamUI, which sets up ClamAV; Vigil then scans Downloads every week.",
                   ("terminal", "install-clamui", "Install ClamUI")),
    "bumblebee": ("Install the Bumblebee plugin and let it scan; if it finds something, open it from the bar "
                  "for the affected packages and what to do.", ("docs", "bumblebee", "Learn more")),
    "omarchy-plugins": ("Nothing to fix. Remove plugins you do not use with omarchy plugin remove <id>.",
                        ("terminal", "show-plugins", "List plugins")),
    "exposed-secrets": ("Treat each key as leaked: revoke or rotate it with the service that issued it, then "
                        "delete the line from your shell history (Edit history).",
                        ("terminal", "edit-shell-history", "Edit history")),
    "accounts": ("Get help before changing accounts; a mistake can lock you out.",
                 ("docs", "arch-users", "Learn more")),
    "shell-history": ("If you did not set this up yourself, get help before changing anything.",
                      ("docs", "attack-history", "Learn more")),
    "black-ops": ("Optional. Install Black Ops from the Omarchy plugin catalog to block telemetry.",
                  ("docs", "black-ops", "Learn more")),
}


def add_help(c):
    """Make sure every finding that is not passing says how to fix it and has a button."""
    if c["status"] in ("pass", "na"):
        return c
    howto, learn = CHECK_HELP.get(c["id"], ("", None))
    if c["fix"]["kind"] == "none" and learn and c["status"] != "unknown":
        c["fix"] = fix(*learn)
    if not c.get("howto"):
        c["howto"] = UNKNOWN_HOWTO if c["status"] == "unknown" else howto
    return c


def tidy(c):
    add_help(c)
    c.setdefault("howto", "")
    for k in ("title", "summary", "why", "howto"):
        c[k] = clean(c[k], 400 if k in ("why", "howto") else STR_MAX)
    c["detail"] = clean(c["detail"], 3000) if "\n" not in c["detail"] else "\n".join(
        clean(x, STR_MAX) for x in c["detail"].splitlines()[:LIST_MAX + 1])
    return c


def audit(peek=False):
    started = time.monotonic()
    _SYSTEMCTL_MEMO.clear()
    INTEGRITY_PEEK["value"] = peek
    checks = []
    for fn in CHECKS:
        try:
            c = fn()
            if c is None:          # a check with nothing to show on this machine
                continue
        except Exception as e:  # one broken check must not hide the others
            c = result(fn.__name__.replace("check_", "").replace("_", "-"), "harden", fn.__name__,
                       "unknown", "This check failed to run (%s)." % type(e).__name__)
        checks.append(tidy(c))
    state = load_state()
    dismissed = state_dismissed(state)
    for c in checks:
        c["dismissible"] = dismissible(c)
        fp = fingerprint(c)
        c["dismissed"] = c["dismissible"] and fp in dismissed
        c["dismissedAt"] = dismissed.get(fp, "") if c["dismissed"] else ""
        action = CHECK_UNDO.get(c["id"], "")
        c["undo"] = {"action": action, "label": "Undo Vigil's change"} if action and undo_available(action) \
            else {"action": "", "label": ""}
    counts = {k: 0 for k in ("fail", "warn", "pass", "info", "na", "unknown")}
    for c in checks:
        counts[c["status"]] = counts.get(c["status"], 0) + 1
    counts["dismissed"] = sum(1 for c in checks if c["dismissed"])
    scored = [c for c in checks if c["weight"] > 0 and not c["dismissed"]]
    level = "fail" if any(c["status"] == "fail" for c in scored) else (
        "warn" if any(c["status"] == "warn" for c in scored) else "ok")
    tools = {}
    for name in ("omarchy-launch-floating-terminal-with-presentation", "omarchy-setup-security-usb-authorization",
                 "omarchy-setup-security-thunderbolt-authorization", "omarchy-setup-security-fido2",
                 "omarchy-sudo-passwordless", "omarchy-remove-security-sudoless-docker", "omarchy-update",
                 "omarchy-pkg-add", "omarchy-update-orphan-pkgs", "omarchy-toggle-idle", "omarchy-shell-config",
                 "omarchy-plugin-list", "xdg-open"):
        p = find_tool(name)
        tools[name] = p.rsplit("/", 1)[0] if p else ""
    report = {
        "schema": SCHEMA, "version": VERSION,
        "generatedAt": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "durationMs": int((time.monotonic() - started) * 1000),
        "score": score_of(checks), "level": level, "counts": counts,
        "checks": checks, "tools": tools, "apps": {"clamui": clamui_install()},
        "new": [], "stateSaved": False, "history": state_history(state),
        "feedsDue": any(feed_due(n) for n in FEED_FILES),
        "feedsUpdated": feeds_updated(),
        "sources": source_status(),
        "lastRun": last_run(),
    }
    if not peek:
        report["new"], report["stateSaved"] = update_state(report)
    return report


# ---------------------------------------------------------------------------
# User-level fixes (no root, no network). Each is a fixed action id.

OPT_OUT_TEXT = (
    "# Written by Vigil (keasbeexd.vigil). Remove from the Vigil panel or delete this file.\n"
    "# Read by uwsm at login; takes effect from the next session.\n"
    "export DO_NOT_TRACK=1\n"
    "export DOTNET_CLI_TELEMETRY_OPTOUT=1\n"
    "export HOMEBREW_NO_ANALYTICS=1\n"
    "export GATSBY_TELEMETRY_DISABLED=1\n"
    "export NEXT_TELEMETRY_DISABLED=1\n"
    "export NUXT_TELEMETRY_DISABLED=1\n"
    "export ASTRO_TELEMETRY_DISABLED=1\n"
    "export AZURE_CORE_COLLECT_TELEMETRY=0\n"
    "export SAM_CLI_TELEMETRY=0\n"
    "export POWERSHELL_TELEMETRY_OPTOUT=1\n"
    "export STORYBOOK_DISABLE_TELEMETRY=1\n"
    "export TURBO_TELEMETRY_DISABLED=1\n"
    "export SCARF_ANALYTICS=false\n"
)


def fix_ssh_perms():
    dfd = _open_home_dir([".ssh"])
    changed = 0
    try:
        if stat.S_IMODE(os.fstat(dfd).st_mode) != 0o700:
            os.fchmod(dfd, 0o700)
            changed += 1
        with os.scandir(dfd) as it:
            names = sorted(e.name for e in it)[:256]
        for name in names:
            try:
                fd = os.open(name, O_READ | os.O_NOFOLLOW, dir_fd=dfd)
            except OSError:
                continue
            try:
                st = os.fstat(fd)
                if not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid():
                    continue
                if st.st_size <= SMALL_FILE_MAX and _private_key_state(_read_fd(fd, SMALL_FILE_MAX))[0]:
                    if stat.S_IMODE(st.st_mode) & 0o077:
                        os.fchmod(fd, 0o600)
                        changed += 1
            except Refused:
                continue
            finally:
                os.close(fd)
    finally:
        os.close(dfd)
    return "Fixed %d permission%s in ~/.ssh." % (changed, "" if changed == 1 else "s")


def fix_gnupg_perms():
    dfd = _open_home_dir([".gnupg"])
    try:
        os.fchmod(dfd, 0o700)
    finally:
        os.close(dfd)
    return "~/.gnupg is now readable only by you."


def fix_optout_on():
    dfd = _open_home_dir(list(OPT_OUT_DIR), create=True)
    try:
        write_atomic(dfd, OPT_OUT_NAME, OPT_OUT_TEXT.encode(), 0o644)
    finally:
        os.close(dfd)
    return "Opt-out variables set. They apply from your next login."


def fix_optout_off():
    try:
        dfd = _open_home_dir(list(OPT_OUT_DIR))
    except FileNotFoundError:
        return "Nothing to remove."
    try:
        try:
            fd = os.open(OPT_OUT_NAME, O_READ | os.O_NOFOLLOW, dir_fd=dfd)
        except FileNotFoundError:
            return "Nothing to remove."
        try:
            st = os.fstat(fd)
            data = _read_fd(fd, SMALL_FILE_MAX)
        finally:
            os.close(fd)
        # Remove only a file whose bytes prove Vigil wrote it.
        if data != OPT_OUT_TEXT.encode() or st.st_uid != os.geteuid():
            raise Refused("the file was changed by hand; leaving it alone")
        os.unlink(OPT_OUT_NAME, dir_fd=dfd)
        os.fsync(dfd)
    finally:
        os.close(dfd)
    return "Opt-out variables removed. They stop applying from your next login."


def _own_writable_dir(dfd):
    """True if dfd is our directory; makes it writable first (Go and other
    tools leave read-only folders behind, which would otherwise never empty)."""
    st = os.fstat(dfd)
    if st.st_uid != os.geteuid():
        return False
    if st.st_mode & 0o700 != 0o700:
        os.fchmod(dfd, stat.S_IMODE(st.st_mode) | 0o700)
    return True


def _clear_dir_contents(dfd, budget):
    """Delete regular files and empty subdirectories below dfd without ever
    following a symlink; symlinks themselves are unlinked, never followed."""
    removed = 0
    with os.scandir(dfd) as it:
        entries = [(e.name, e.is_dir(follow_symlinks=False)) for e in it][:budget[0]]
    for name, is_dir in entries:
        if budget[0] <= 0:
            break
        budget[0] -= 1
        if is_dir:
            try:
                sub = os.open(name, O_DIR, dir_fd=dfd)
            except OSError:
                continue
            try:
                if not _own_writable_dir(sub):
                    continue
                removed += _clear_dir_contents(sub, budget)
            finally:
                os.close(sub)
            try:
                os.rmdir(name, dir_fd=dfd)
            except OSError:
                pass
        else:
            try:
                os.unlink(name, dir_fd=dfd)
                removed += 1
            except OSError:
                pass
    return removed


def fix_clean_thumbnails():
    try:
        dfd = _open_home_dir([".cache", "thumbnails"])
    except FileNotFoundError:
        return "The thumbnail cache is already empty."
    try:
        n = _clear_dir_contents(dfd, [WALK_MAX_ENTRIES])
    finally:
        os.close(dfd)
    return "Removed %d thumbnail%s." % (n, "" if n == 1 else "s")


TRASH = (".local", "share", "Trash")


def fix_empty_trash():
    """Empty the trash directly, following the freedesktop.org trash layout
    (files/, info/, expunged/ and the directorysizes cache). This needs no
    desktop session, which the helper deliberately does not have."""
    budget = [WALK_MAX_ENTRIES]
    found = False
    for sub in ("files", "info", "expunged"):
        try:
            dfd = _open_home_dir(list(TRASH) + [sub])
        except FileNotFoundError:
            continue
        found = True
        try:
            _clear_dir_contents(dfd, budget)
        finally:
            os.close(dfd)
    try:
        tfd = _open_home_dir(list(TRASH))
    except FileNotFoundError:
        tfd = None
    if tfd is not None:
        try:
            os.unlink("directorysizes", dir_fd=tfd)
        except OSError:
            pass
        finally:
            os.close(tfd)
    if not found:
        return "The trash is already empty."
    if budget[0] <= 0:
        return "Emptied part of the trash; it held too many files for one go. Run it again."
    return "Trash emptied."


def _clear_unused(dfd, cutoff, budget):
    """Delete our files below dfd that nothing has read or written since cutoff,
    and folders that were already that old and are now empty. Returns bytes freed."""
    freed = 0
    with os.scandir(dfd) as it:
        names = [e.name for e in it][:max(0, budget[0])]
    for name in names:
        if budget[0] <= 0:
            break
        budget[0] -= 1
        try:
            st = os.stat(name, dir_fd=dfd, follow_symlinks=False)
        except OSError:
            continue
        if stat.S_ISDIR(st.st_mode):
            try:
                sub = os.open(name, O_DIR, dir_fd=dfd)
            except OSError:
                continue
            try:
                if not _own_writable_dir(sub):
                    continue
                freed += _clear_unused(sub, cutoff, budget)
            finally:
                os.close(sub)
            if st.st_mtime < cutoff:
                try:
                    os.rmdir(name, dir_fd=dfd)
                except OSError:
                    pass
        elif st.st_uid == os.geteuid() and max(st.st_atime, st.st_mtime) < cutoff:
            try:
                os.unlink(name, dir_fd=dfd)
                freed += st.st_blocks * 512 if stat.S_ISREG(st.st_mode) else 0
            except OSError:
                pass
    return freed


def fix_clean_app_cache():
    try:
        dfd = _open_home_dir([".cache"])
    except FileNotFoundError:
        return "There are no application caches."
    try:
        cutoff, budget, freed = _cache_cutoff(), [WALK_MAX_ENTRIES], 0
        with os.scandir(dfd) as it:
            tops = [e.name for e in it if e.name not in CACHE_SKIP]
        for name in tops:
            try:
                st = os.stat(name, dir_fd=dfd, follow_symlinks=False)
            except OSError:
                continue
            if stat.S_ISDIR(st.st_mode):
                try:
                    sub = os.open(name, O_DIR, dir_fd=dfd)
                except OSError:
                    continue
                try:
                    if _own_writable_dir(sub):
                        freed += _clear_unused(sub, cutoff, budget)
                finally:
                    os.close(sub)
                if st.st_mtime < cutoff:
                    try:
                        os.rmdir(name, dir_fd=dfd)
                    except OSError:
                        pass
            elif st.st_uid == os.geteuid() and max(st.st_atime, st.st_mtime) < cutoff:
                try:
                    os.unlink(name, dir_fd=dfd)
                    freed += st.st_blocks * 512 if stat.S_ISREG(st.st_mode) else 0
                except OSError:
                    pass
    finally:
        os.close(dfd)
    if not freed:
        return "No application cache needed clearing."
    return "Freed %s of application cache unused for a week." % human(freed)


def fix_clean_user():
    """Clean all, the part that needs no root: thumbnails, the trash, unused caches."""
    msgs = [fix_clean_thumbnails(), fix_empty_trash(), fix_clean_app_cache()]
    return " ".join(m for m in msgs if "already empty" not in m and "application cache" not in m.split(" of ")[0]
                    and "No application cache" not in m and "no application caches" not in m) \
        or "Nothing needed cleaning."


def fix_credential_perms():
    changed = 0
    for parts in CREDENTIAL_FILES:
        try:
            dfd = _open_home_dir(list(parts[:-1]))
        except (FileNotFoundError, Refused):
            continue
        try:
            try:
                fd = os.open(parts[-1], O_READ | os.O_NOFOLLOW, dir_fd=dfd)
            except OSError:
                continue
            try:
                st = os.fstat(fd)
                if stat.S_ISREG(st.st_mode) and st.st_uid == os.geteuid() and st.st_mode & 0o077:
                    os.fchmod(fd, 0o600)
                    changed += 1
            finally:
                os.close(fd)
        finally:
            os.close(dfd)
    return "Made %d credential file%s private." % (changed, "" if changed == 1 else "s")


def _missing(what):
    raise Refused("%s is not installed" % what)


def fix_integrity_accept():
    snap = integrity_snapshot()
    save_baseline(snap)
    return "Recorded %d files as the new normal." % len(snap)


FIXES = {
    "credential-perms": fix_credential_perms,
    "integrity-accept": fix_integrity_accept,
    "arch-audit-refresh": lambda: refresh_arch_audit() if feed_available("arch-audit") else _missing("arch-audit"),
    "osv-refresh": lambda: refresh_osv() if feed_available("osv") else _missing("osv-scanner"),
    "aur-refresh": lambda: refresh_aur() if feed_available("aur") else _missing("pacman or curl"),
    "virus-scan-now": lambda: refresh_virus_scan() if feed_available("virus-scan") else _missing("ClamAV"),
    "ssh-perms": fix_ssh_perms,
    "gnupg-perms": fix_gnupg_perms,
    "optout-on": fix_optout_on,
    "optout-off": fix_optout_off,
    "clean-thumbnails": fix_clean_thumbnails,
    "empty-trash": fix_empty_trash,
    "clean-user": fix_clean_user,
    "clean-app-cache": fix_clean_app_cache,
}


def run_fix(action):
    fn = FIXES.get(action)
    if fn is None:
        return {"ok": False, "action": "", "message": "Unknown action."}
    try:
        msg = fn()
        return {"ok": True, "action": action, "message": clean(msg)}
    except FileNotFoundError:
        return {"ok": False, "action": action, "message": "Nothing to change."}
    except Refused as e:
        return {"ok": False, "action": action, "message": clean("Refused: %s" % e)}
    except OSError as e:
        return {"ok": False, "action": action, "message": clean("Failed: %s" % (os.strerror(e.errno or 0) or e))}


# ---------------------------------------------------------------------------

def emit(obj):
    data = json.dumps(obj, separators=(",", ":"), ensure_ascii=True)
    sys.stdout.write(data + "\n")
    sys.stdout.flush()


def main(argv):
    os.umask(0o077)
    if len(argv) in (2, 3) and argv[1] == "audit" and argv[2:] in ([], ["--peek"]):
        # --peek: report only, leave the seen-findings state alone (used by bar
        # instances on secondary monitors so only one instance notifies).
        emit(audit(peek=len(argv) == 3))
        return 0
    if len(argv) == 3 and argv[1] == "fix" and re.fullmatch(r"[a-z][a-z0-9-]{0,31}", argv[2]):
        emit(run_fix(argv[2]))
        return 0
    if len(argv) == 3 and argv[1] in ("dismiss", "undismiss") and re.fullmatch(r"[a-z0-9-]{1,40}", argv[2]):
        emit(set_dismissed(argv[2], argv[1] == "dismiss"))
        return 0
    if len(argv) in (2, 3) and argv[1] == "refresh-feeds" and argv[2:] in ([], ["--force"], ["--sources"]):
        emit(refresh_due_feeds(force=len(argv) == 3, sources_only=argv[2:] == ["--sources"]))
        return 0
    if len(argv) == 2 and argv[1] == "version":
        emit({"version": VERSION})
        return 0
    sys.stderr.write("usage: vigil audit [--peek] | vigil fix <action> | vigil dismiss|undismiss <check> | vigil refresh-feeds [--force|--sources] | vigil version\n")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
