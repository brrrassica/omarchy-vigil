# User-level fixes (no root, no network). Each is a fixed action id.

OPT_OUT_TEXT = (
    "# Written by Vigil (io.github.keasbeexd.vigil). Remove from the Vigil panel or delete this file.\n"
    "# Read by uwsm at login; takes effect from the next session.\n"
    "export DO_NOT_TRACK=1\n"
    "export DOTNET_CLI_TELEMETRY_OPTOUT=1\n"
    "export HOMEBREW_NO_ANALYTICS=1\n"
    "export GATSBY_TELEMETRY_DISABLED=1\n"
    "export NEXT_TELEMETRY_DISABLED=1\n"
    "export NUXT_TELEMETRY_DISABLED=1\n"
    "export ASTRO_TELEMETRY_DISABLED=1\n"
    "export AZURE_CORE_COLLECT_TELEMETRY=0\n"
    "export SAM_CLI_TELEMETRY=0\n"
    "export POWERSHELL_TELEMETRY_OPTOUT=1\n"
    "export STORYBOOK_DISABLE_TELEMETRY=1\n"
    "export TURBO_TELEMETRY_DISABLED=1\n"
    "export SCARF_ANALYTICS=false\n"
)


def fix_ssh_perms():
    dfd = _open_home_dir([".ssh"])
    changed = 0
    try:
        if stat.S_IMODE(os.fstat(dfd).st_mode) != 0o700:
            os.fchmod(dfd, 0o700)
            changed += 1
        with os.scandir(dfd) as it:
            names = sorted(e.name for e in it)[:256]
        for name in names:
            try:
                fd = os.open(name, O_READ | os.O_NOFOLLOW, dir_fd=dfd)
            except OSError:
                continue
            try:
                st = os.fstat(fd)
                if not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid():
                    continue
                if st.st_size <= SMALL_FILE_MAX and _private_key_state(_read_fd(fd, SMALL_FILE_MAX))[0]:
                    if stat.S_IMODE(st.st_mode) & 0o077:
                        os.fchmod(fd, 0o600)
                        changed += 1
            except Refused:
                continue
            finally:
                os.close(fd)
    finally:
        os.close(dfd)
    return "Fixed %d permission%s in ~/.ssh." % (changed, "" if changed == 1 else "s")


def fix_gnupg_perms():
    dfd = _open_home_dir([".gnupg"])
    try:
        os.fchmod(dfd, 0o700)
    finally:
        os.close(dfd)
    return "~/.gnupg is now readable only by you."


def fix_optout_on():
    dfd = _open_home_dir(list(OPT_OUT_DIR), create=True)
    try:
        write_atomic(dfd, OPT_OUT_NAME, OPT_OUT_TEXT.encode(), 0o644)
    finally:
        os.close(dfd)
    return "Opt-out variables set. They apply from your next login."


def fix_optout_off():
    try:
        dfd = _open_home_dir(list(OPT_OUT_DIR))
    except FileNotFoundError:
        return "Nothing to remove."
    try:
        try:
            fd = os.open(OPT_OUT_NAME, O_READ | os.O_NOFOLLOW, dir_fd=dfd)
        except FileNotFoundError:
            return "Nothing to remove."
        try:
            st = os.fstat(fd)
            data = _read_fd(fd, SMALL_FILE_MAX)
        finally:
            os.close(fd)
        # Remove only a file whose bytes prove Vigil wrote it.
        if data != OPT_OUT_TEXT.encode() or st.st_uid != os.geteuid():
            raise Refused("the file was changed by hand; leaving it alone")
        os.unlink(OPT_OUT_NAME, dir_fd=dfd)
        os.fsync(dfd)
    finally:
        os.close(dfd)
    return "Opt-out variables removed. They stop applying from your next login."


def _clear_dir_contents(dfd, budget):
    """Delete regular files and empty subdirectories below dfd without ever
    following a symlink; symlinks themselves are unlinked, never followed."""
    removed = 0
    with os.scandir(dfd) as it:
        entries = [(e.name, e.is_dir(follow_symlinks=False)) for e in it][:budget[0]]
    for name, is_dir in entries:
        if budget[0] <= 0:
            break
        budget[0] -= 1
        if is_dir:
            try:
                sub = os.open(name, O_DIR, dir_fd=dfd)
            except OSError:
                continue
            try:
                if os.fstat(sub).st_uid != os.geteuid():
                    continue
                removed += _clear_dir_contents(sub, budget)
            finally:
                os.close(sub)
            try:
                os.rmdir(name, dir_fd=dfd)
            except OSError:
                pass
        else:
            try:
                os.unlink(name, dir_fd=dfd)
                removed += 1
            except OSError:
                pass
    return removed


def fix_clean_thumbnails():
    try:
        dfd = _open_home_dir([".cache", "thumbnails"])
    except FileNotFoundError:
        return "The thumbnail cache is already empty."
    try:
        n = _clear_dir_contents(dfd, [WALK_MAX_ENTRIES])
    finally:
        os.close(dfd)
    return "Removed %d thumbnail%s." % (n, "" if n == 1 else "s")


def fix_empty_trash():
    gio = "/usr/bin/gio"
    if not is_trusted_executable(sys_path(gio)):
        raise Refused("gio is not installed")
    rc, _ = run([gio, "trash", "--empty"], timeout=60, limit=4096)
    if rc != 0:
        raise Refused("gio could not empty the trash")
    return "Trash emptied."


FIXES = {
    "ssh-perms": fix_ssh_perms,
    "gnupg-perms": fix_gnupg_perms,
    "optout-on": fix_optout_on,
    "optout-off": fix_optout_off,
    "clean-thumbnails": fix_clean_thumbnails,
    "empty-trash": fix_empty_trash,
}


def run_fix(action):
    fn = FIXES.get(action)
    if fn is None:
        return {"ok": False, "action": "", "message": "Unknown action."}
    try:
        msg = fn()
        return {"ok": True, "action": action, "message": clean(msg)}
    except FileNotFoundError:
        return {"ok": False, "action": action, "message": "Nothing to change."}
    except Refused as e:
        return {"ok": False, "action": action, "message": clean("Refused: %s" % e)}
    except OSError as e:
        return {"ok": False, "action": action, "message": clean("Failed: %s" % (os.strerror(e.errno or 0) or e))}


# ---------------------------------------------------------------------------

def emit(obj):
    data = json.dumps(obj, separators=(",", ":"), ensure_ascii=True)
    sys.stdout.write(data + "\n")
    sys.stdout.flush()


def main(argv):
    os.umask(0o077)
    if len(argv) in (2, 3) and argv[1] == "audit" and argv[2:] in ([], ["--peek"]):
        # --peek: report only, leave the seen-findings state alone (used by bar
        # instances on secondary monitors so only one instance notifies).
        emit(audit(peek=len(argv) == 3))
        return 0
    if len(argv) == 3 and argv[1] == "fix" and re.fullmatch(r"[a-z][a-z0-9-]{0,31}", argv[2]):
        emit(run_fix(argv[2]))
        return 0
    if len(argv) == 2 and argv[1] == "version":
        emit({"version": VERSION})
        return 0
    sys.stderr.write("usage: vigil audit [--peek] | vigil fix <action> | vigil version\n")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
