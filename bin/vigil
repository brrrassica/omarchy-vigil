    "virus-scan": ("Install ClamUI, which sets up ClamAV; Vigil then scans Downloads every week.",
                   ("terminal", "install-clamui", "Install ClamUI")),
    "bumblebee": ("Bumblebee runs with the daily check. Perplexity explains what it checks and how its list "
                  "is kept.", ("docs", "bumblebee", "Learn more")),
    "omarchy-plugins": ("Nothing to fix. Remove plugins you do not use with omarchy plugin remove <id>.",
                        ("terminal", "show-plugins", "List plugins")),
    "accounts": ("Get help before changing accounts; a mistake can lock you out.",
                 ("docs", "arch-users", "Learn more")),
    "shell-history": ("If you did not set this up yourself, get help before changing anything.",
                      ("docs", "attack-history", "Learn more")),
    "black-ops": ("Optional. Install Black Ops from the Omarchy plugin catalog to block telemetry.",
                  ("docs", "black-ops", "Learn more")),
}


def add_help(c):
    """Make sure every finding that is not passing says how to fix it and has a button."""
    if c["status"] in ("pass", "na"):
        return c
    howto, learn = CHECK_HELP.get(c["id"], ("", None))
    if c["fix"]["kind"] == "none" and learn and c["status"] != "unknown":
        c["fix"] = fix(*learn)
    if not c.get("howto"):
        c["howto"] = UNKNOWN_HOWTO if c["status"] == "unknown" else howto
    return c


def tidy(c):
    add_help(c)
    c.setdefault("howto", "")
    for k in ("title", "summary", "why", "howto"):
        c[k] = clean(c[k], 400 if k in ("why", "howto") else STR_MAX)
    c["detail"] = clean(c["detail"], 3000) if "\n" not in c["detail"] else "\n".join(
        clean(x, STR_MAX) for x in c["detail"].splitlines()[:LIST_MAX + 1])
    return c


def audit(peek=False):
    started = time.monotonic()
    _SYSTEMCTL_MEMO.clear()
    INTEGRITY_PEEK["value"] = peek
    checks = []
    for fn in CHECKS:
        try:
            c = fn()
            if c is None:          # a check with nothing to show on this machine
                continue
        except Exception as e:  # one broken check must not hide the others
            c = result(fn.__name__.replace("check_", "").replace("_", "-"), "harden", fn.__name__,
                       "unknown", "This check failed to run (%s)." % type(e).__name__)
        checks.append(tidy(c))
    state = load_state()
    dismissed = state_dismissed(state)
    for c in checks:
        c["dismissible"] = dismissible(c)
        fp = fingerprint(c)
        c["dismissed"] = c["dismissible"] and fp in dismissed
        c["dismissedAt"] = dismissed.get(fp, "") if c["dismissed"] else ""
        own = c.pop("_undo", None)
        action = CHECK_UNDO.get(c["id"], "")
        c["undo"] = own if own and (own["action"] not in TOOL_UNDO or find_tool(TOOL_UNDO[own["action"]])) else (
            {"action": action, "label": "Undo Vigil's change"} if action and undo_available(action)
            else {"action": "", "label": ""})
    counts = {k: 0 for k in ("fail", "warn", "pass", "info", "na", "unknown")}
    for c in checks:
        counts[c["status"]] = counts.get(c["status"], 0) + 1
    counts["dismissed"] = sum(1 for c in checks if c["dismissed"])
    scored = [c for c in checks if c["weight"] > 0 and not c["dismissed"]]
    level = "fail" if any(c["status"] == "fail" for c in scored) else (
        "warn" if any(c["status"] == "warn" for c in scored) else "ok")
    tools = {}
    for name in ("omarchy-launch-floating-terminal-with-presentation", "omarchy-setup-security-fido2",
                 "omarchy-update-firmware",
                 "omarchy-remove-security-fido2", "omarchy-setup-security-fingerprint",
                 "omarchy-remove-security-fingerprint",
                 "omarchy-sudo-passwordless", "omarchy-remove-security-sudoless-docker", "omarchy-update",
                 "omarchy-pkg-add", "omarchy-update-orphan-pkgs", "omarchy-toggle-idle", "omarchy-shell-config",
                 "omarchy-plugin-list", "xdg-open", "pkexec"):
        p = find_tool(name)
        tools[name] = p.rsplit("/", 1)[0] if p else ""
    running = run_in_progress()
    report = {
        "schema": SCHEMA, "version": VERSION,
        "generatedAt": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "durationMs": int((time.monotonic() - started) * 1000),
        "score": score_of(checks), "level": level, "counts": counts,
        "checks": checks, "tools": tools, "apps": {"clamui": clamui_install()},
        "new": [], "stateSaved": False, "history": state_history(state),
        "feedsDue": running is None and (any(feed_due(n) for n in SOURCE_FEEDS + DAILY_FEEDS)
                                         or feed_due("full-scan")),
        "feedsUpdated": feeds_updated(),
        "sources": source_status(),
        "lastRun": last_run(),
        "nextUpdate": next_update(),
        "nextFullScan": next_full_scan(),
        "nextDaily": next_daily(),
        "missing": missing_helpers(),
        "running": running,
    }
    if not peek:
        report["new"], report["stateSaved"] = update_state(report)
    return report


# ---------------------------------------------------------------------------
# User-level fixes (no root, no network). Each is a fixed action id.

OPT_OUT_TEXT = (
    "# Written by Vigil (keasbeexd.vigil). Remove from the Vigil panel or delete this file.\n"
    "# Read by uwsm at login; takes effect from the next session.\n"
    "export DO_NOT_TRACK=1\n"
    "export DOTNET_CLI_TELEMETRY_OPTOUT=1\n"
    "export HOMEBREW_NO_ANALYTICS=1\n"
    "export GATSBY_TELEMETRY_DISABLED=1\n"
    "export NEXT_TELEMETRY_DISABLED=1\n"
    "export NUXT_TELEMETRY_DISABLED=1\n"
    "export ASTRO_TELEMETRY_DISABLED=1\n"
    "export AZURE_CORE_COLLECT_TELEMETRY=0\n"
    "export SAM_CLI_TELEMETRY=0\n"
    "export POWERSHELL_TELEMETRY_OPTOUT=1\n"
    "export STORYBOOK_DISABLE_TELEMETRY=1\n"
    "export TURBO_TELEMETRY_DISABLED=1\n"
    "export SCARF_ANALYTICS=false\n"
)


def fix_ssh_perms():
    dfd = _open_home_dir([".ssh"])
    changed = 0
    try:
        if stat.S_IMODE(os.fstat(dfd).st_mode) != 0o700:
            os.fchmod(dfd, 0o700)
            changed += 1
        with os.scandir(dfd) as it:
            names = sorted(e.name for e in it)[:256]
        for name in names:
            try:
                fd = os.open(name, O_READ | os.O_NOFOLLOW, dir_fd=dfd)
            except OSError:
                continue
            try:
                st = os.fstat(fd)
                if not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid():
                    continue
                if st.st_size <= SMALL_FILE_MAX and _private_key_state(_read_fd(fd, SMALL_FILE_MAX))[0]:
                    if stat.S_IMODE(st.st_mode) & 0o077:
                        os.fchmod(fd, 0o600)
                        changed += 1
            except Refused:
                continue
            finally:
                os.close(fd)
    finally:
        os.close(dfd)
    return "Fixed %d permission%s in ~/.ssh." % (changed, "" if changed == 1 else "s")


def fix_gnupg_perms():
    dfd = _open_home_dir([".gnupg"])
    try:
        os.fchmod(dfd, 0o700)
    finally:
        os.close(dfd)
    return "~/.gnupg is now readable only by you."


def fix_optout_on():
    dfd = _open_home_dir(list(OPT_OUT_DIR), create=True)
    try:
        write_atomic(dfd, OPT_OUT_NAME, OPT_OUT_TEXT.encode(), 0o644)
    finally:
        os.close(dfd)
    return "Opt-out variables set. They apply from your next login."


def fix_optout_off():
    try:
        dfd = _open_home_dir(list(OPT_OUT_DIR))
    except FileNotFoundError:
        return "Nothing to remove."
    try:
        try:
            fd = os.open(OPT_OUT_NAME, O_READ | os.O_NOFOLLOW, dir_fd=dfd)
        except FileNotFoundError:
            return "Nothing to remove."
        try:
            st = os.fstat(fd)
            data = _read_fd(fd, SMALL_FILE_MAX)
        finally:
            os.close(fd)
        # Remove only a file whose bytes prove Vigil wrote it.
        if data != OPT_OUT_TEXT.encode() or st.st_uid != os.geteuid():
            raise Refused("the file was changed by hand; leaving it alone")
        os.unlink(OPT_OUT_NAME, dir_fd=dfd)
        os.fsync(dfd)
    finally:
        os.close(dfd)
    return "Opt-out variables removed. They stop applying from your next login."


def _own_writable_dir(dfd):
    """True if dfd is our directory; makes it writable first (Go and other
    tools leave read-only folders behind, which would otherwise never empty)."""
    st = os.fstat(dfd)
    if st.st_uid != os.geteuid():
        return False
    if st.st_mode & 0o700 != 0o700:
        os.fchmod(dfd, stat.S_IMODE(st.st_mode) | 0o700)
    return True


def _clear_dir_contents(dfd, budget):
    """Delete regular files and empty subdirectories below dfd without ever
    following a symlink; symlinks themselves are unlinked, never followed."""
    removed = 0
    with os.scandir(dfd) as it:
        entries = [(e.name, e.is_dir(follow_symlinks=False)) for e in it][:budget[0]]
    for name, is_dir in entries:
        if budget[0] <= 0:
            break
        budget[0] -= 1
        if is_dir:
            try:
                sub = os.open(name, O_DIR, dir_fd=dfd)
            except OSError:
                continue
            try:
                if not _own_writable_dir(sub):
                    continue
                removed += _clear_dir_contents(sub, budget)
            finally:
                os.close(sub)
            try:
                os.rmdir(name, dir_fd=dfd)
            except OSError:
                pass
        else:
            try:
                os.unlink(name, dir_fd=dfd)
                removed += 1
            except OSError:
                pass
    return removed


def fix_clean_thumbnails():
    try:
        dfd = _open_home_dir([".cache", "thumbnails"])
    except FileNotFoundError:
        return "The thumbnail cache is already empty."
    try:
        n = _clear_dir_contents(dfd, [WALK_MAX_ENTRIES])
    finally:
        os.close(dfd)
    return "Removed %d thumbnail%s." % (n, "" if n == 1 else "s")


TRASH = (".local", "share", "Trash")


def fix_empty_trash():
    """Empty the trash directly, following the freedesktop.org trash layout
    (files/, info/, expunged/ and the directorysizes cache). This needs no
    desktop session, which the helper deliberately does not have."""
    budget = [WALK_MAX_ENTRIES]
    found = False
    for sub in ("files", "info", "expunged"):
        try:
            dfd = _open_home_dir(list(TRASH) + [sub])
        except FileNotFoundError:
            continue
        found = True
        try:
            _clear_dir_contents(dfd, budget)
        finally:
            os.close(dfd)
    try:
        tfd = _open_home_dir(list(TRASH))
    except FileNotFoundError:
        tfd = None
    if tfd is not None:
        try:
            os.unlink("directorysizes", dir_fd=tfd)
        except OSError:
            pass
        finally:
            os.close(tfd)
    if not found:
        return "The trash is already empty."
    if budget[0] <= 0:
        return "Emptied part of the trash; it held too many files for one go. Run it again."
    return "Trash emptied."


def _clear_unused(dfd, cutoff, budget):
    """Delete our files below dfd that nothing has read or written since cutoff,
    and folders that were already that old and are now empty. Returns bytes freed."""
    freed = 0
    with os.scandir(dfd) as it:
        names = [e.name for e in it][:max(0, budget[0])]
    for name in names:
        if budget[0] <= 0:
            break
        budget[0] -= 1
        try:
            st = os.stat(name, dir_fd=dfd, follow_symlinks=False)
        except OSError:
            continue
        if stat.S_ISDIR(st.st_mode):
            try:
                sub = os.open(name, O_DIR, dir_fd=dfd)
            except OSError:
                continue
            try:
                if not _own_writable_dir(sub):
                    continue
                freed += _clear_unused(sub, cutoff, budget)
            finally:
                os.close(sub)
            if st.st_mtime < cutoff:
                try:
                    os.rmdir(name, dir_fd=dfd)
                except OSError:
                    pass
        elif st.st_uid == os.geteuid() and max(st.st_atime, st.st_mtime) < cutoff:
            try:
                os.unlink(name, dir_fd=dfd)
                freed += st.st_blocks * 512 if stat.S_ISREG(st.st_mode) else 0
            except OSError:
                pass
    return freed


def fix_clean_app_cache():
    try:
        dfd = _open_home_dir([".cache"])
    except FileNotFoundError:
        return "There are no application caches."
    try:
        cutoff, budget, freed = _cache_cutoff(), [WALK_MAX_ENTRIES], 0
        with os.scandir(dfd) as it:
            tops = [e.name for e in it if e.name not in CACHE_SKIP]
        for name in tops:
            try:
                st = os.stat(name, dir_fd=dfd, follow_symlinks=False)
            except OSError:
                continue
            if stat.S_ISDIR(st.st_mode):
                try:
                    sub = os.open(name, O_DIR, dir_fd=dfd)
                except OSError:
                    continue
                try:
                    if _own_writable_dir(sub):
                        freed += _clear_unused(sub, cutoff, budget)
                finally:
                    os.close(sub)
                if st.st_mtime < cutoff:
                    try:
                        os.rmdir(name, dir_fd=dfd)
                    except OSError:
                        pass
            elif st.st_uid == os.geteuid() and max(st.st_atime, st.st_mtime) < cutoff:
                try:
                    os.unlink(name, dir_fd=dfd)
                    freed += st.st_blocks * 512 if stat.S_ISREG(st.st_mode) else 0
                except OSError:
                    pass
    finally:
        os.close(dfd)
    if not freed:
        return "No application cache needed clearing."
    return "Freed %s of application cache unused for a week." % human(freed)


def fix_clean_user():
    """Clean all, the part that needs no root: thumbnails, the trash, unused caches."""
    msgs = [fix_clean_thumbnails(), fix_empty_trash(), fix_clean_app_cache()]
    return " ".join(m for m in msgs if "already empty" not in m and "application cache" not in m.split(" of ")[0]
                    and "No application cache" not in m and "no application caches" not in m) \
        or "Nothing needed cleaning."


def _secret_line(line):
    return any(rx.search(line) for rx, _ in SECRET_PATTERNS)


def fix_remove_secret_lines():
    """Delete the history lines that hold a key, as you; fish entries go whole."""
    removed = 0
    for parts in HISTORY_FILES:
        try:
            dfd = _open_home_dir(list(parts[:-1]))
        except (FileNotFoundError, Refused):
            continue
        try:
            raw = _read_state_bytes(dfd, parts[-1], 64 * 1024 * 1024)
            if raw is None:
                continue
            mode = stat.S_IMODE(os.stat(parts[-1], dir_fd=dfd, follow_symlinks=False).st_mode)
            lines = raw.decode("utf-8", "surrogateescape").split("\n")
            fish = parts[-1] == "fish_history"
            out, skipping, n = [], False, 0
            for line in lines:
                if fish and skipping and line.startswith("  "):
                    continue                   # the rest of a removed fish entry
                skipping = False
                if _secret_line(line):
                    n += 1
                    skipping = fish
                    continue
                out.append(line)
            if n:
                write_atomic(dfd, parts[-1], "\n".join(out).encode("utf-8", "surrogateescape"), mode=mode & 0o600 or 0o600)
                removed += n
        except Refused:
            continue
        finally:
            os.close(dfd)
    if not removed:
        return "No lines with keys were found."
    return ("Removed %d line%s with keys from your shell history. Revoke those keys with the services "
            "that issued them, too." % (removed, "" if removed == 1 else "s"))


def fix_credential_perms():
    changed = 0
    for parts in CREDENTIAL_FILES:
        try:
            dfd = _open_home_dir(list(parts[:-1]))
        except (FileNotFoundError, Refused):
            continue
        try:
            try:
                fd = os.open(parts[-1], O_READ | os.O_NOFOLLOW, dir_fd=dfd)
            except OSError:
                continue
            try:
                st = os.fstat(fd)
                if stat.S_ISREG(st.st_mode) and st.st_uid == os.geteuid() and st.st_mode & 0o077:
                    os.fchmod(fd, 0o600)
                    changed += 1
            finally:
                os.close(fd)
        finally:
            os.close(dfd)
    return "Made %d credential file%s private." % (changed, "" if changed == 1 else "s")


def _missing(what):
    raise Refused("%s is not installed" % what)


def fix_integrity_accept():
    snap = integrity_snapshot()
    save_baseline(snap)
    return "Recorded %d files as the new normal." % len(snap)


FIXES = {
    "credential-perms": fix_credential_perms,
    "integrity-accept": fix_integrity_accept,
    "arch-audit-refresh": lambda: refresh_arch_audit() if feed_available("arch-audit") else _missing("arch-audit"),
    "osv-refresh": lambda: refresh_osv() if feed_available("osv") else _missing("osv-scanner"),
    "aur-refresh": lambda: refresh_aur() if feed_available("aur") else _missing("pacman or curl"),
    "virus-scan-now": lambda: refresh_virus_scan() if feed_available("virus-scan") else _missing("ClamAV"),
    "ssh-perms": fix_ssh_perms,
    "gnupg-perms": fix_gnupg_perms,
    "optout-on": fix_optout_on,
    "optout-off": fix_optout_off,
    "clean-thumbnails": fix_clean_thumbnails,
    "empty-trash": fix_empty_trash,
    "clean-user": fix_clean_user,
    "clean-app-cache": fix_clean_app_cache,
    "remove-secret-lines": fix_remove_secret_lines,
}


def run_fix(action):
    fn = FIXES.get(action)
    if fn is None:
        return {"ok": False, "action": "", "message": "Unknown action."}
    try:
        msg = fn()
        return {"ok": True, "action": action, "message": clean(msg)}
    except FileNotFoundError:
        return {"ok": False, "action": action, "message": "Nothing to change."}
    except Refused as e:
        return {"ok": False, "action": action, "message": clean("Refused: %s" % e)}
    except OSError as e:
        return {"ok": False, "action": action, "message": clean("Failed: %s" % (os.strerror(e.errno or 0) or e))}


# ---------------------------------------------------------------------------

PROGRESS = {"on": False, "saved": 0.0}
RUN_LOCK = {"fd": None}
BUSY_DIR = "busy"
PROGRESS_FILE = "progress.json"
RUN_FILE = "run.json"
STOP = {"on": False}
CURRENT = {"proc": None}


def proc_start(pid):
    """A process's start time (clock ticks since boot) if it runs as us, else None.
    With the pid it names one process, even after the pid is reused."""
    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 1:
        return None
    try:
        if os.stat("/proc/%d" % pid).st_uid != os.geteuid():
            return None
        with open("/proc/%d/stat" % pid, "rb") as f:
            stat_line = f.read(4096).decode("ascii", "replace")
        return int(stat_line.rsplit(")", 1)[1].split()[19])
    except (OSError, ValueError, IndexError):
        return None


def save_run_info(child=None):
    """Who to stop: this helper, and the program it is running now (in its own
    process group, so stopping it also stops what it started, like clamscan
    under nice)."""
    info = {"pid": os.getpid(), "pidStart": proc_start(os.getpid())}
    if child:
        info.update(child=child, childStart=proc_start(child))
    try:
        dirfd = _state_dir()
    except (OSError, Refused):
        return
    try:
        write_atomic(dirfd, RUN_FILE, json.dumps(info, separators=(",", ":")).encode())
    except OSError:
        pass
    finally:
        os.close(dirfd)


def _on_stop(signum, frame):
    """SIGTERM while a run goes: stop the program it is running now and skip
    the remaining steps. Only signals here; run() waits for the program."""
    STOP["on"] = True
    proc = CURRENT["proc"]
    if proc is not None:
        try:
            os.killpg(proc.pid, signal.SIGTERM)
        except OSError:
            pass


def stop_run():
    """`vigil stop`: stop the scan or update that holds the run lock, whoever
    started it. Only processes recorded by that run, still running as you with
    the start time recorded, are signalled."""
    if run_in_progress() is None:
        return {"ok": True, "action": "", "message": "Nothing is running."}
    info = _state_json(RUN_FILE) or {}
    targets = []
    for key, group in (("pid", False), ("child", True)):
        pid, start = info.get(key), info.get(key + "Start")
        if isinstance(start, int) and proc_start(pid) == start:
            targets.append((pid, start, group))

    def send(sig):
        for pid, start, group in targets:
            if proc_start(pid) == start:
                try:
                    os.killpg(pid, sig) if group else os.kill(pid, sig)
                except OSError:
                    pass

    if not targets:
        return {"ok": False, "action": "", "message": "Could not find the run to stop."}
    send(signal.SIGTERM)
    for sig in (None, signal.SIGKILL):
        if sig:
            send(sig)
        deadline = time.monotonic() + (15 if sig is None else 5)
        while time.monotonic() < deadline:
            if run_in_progress() is None:
                return {"ok": True, "action": "", "message": "Stopped."}
            time.sleep(0.25)
    return {"ok": False, "action": "", "message": "It did not stop. A step that asked for your password "
            "may still be waiting: cancel that dialog."}


def take_run_lock():
    """One scan or update at a time, across panels, monitors and shell
    restarts: an exclusive flock on a directory of our own (no lock file to
    plant a link at). The kernel drops it when the last process holding it
    ends. The programs a run starts (clamscan, Bumblebee, the scanners)
    inherit it, so a scan left running after the helper is gone still counts."""
    try:
        fd = _open_home_dir(list(STATE_DIR) + [BUSY_DIR], create=True)
    except (OSError, Refused):
        return False
    for _ in range(5):
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            RUN_LOCK["fd"] = fd
            return True
        except OSError:
            time.sleep(0.1)              # an audit may be checking the lock at this moment
    os.close(fd)
    return False


def run_in_progress():
    """What a scan or update started elsewhere is doing, or None if none runs."""
    try:
        fd = _open_home_dir(list(STATE_DIR) + [BUSY_DIR])
    except (OSError, Refused):
        return None
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
            return None
        except OSError:
            pass
    finally:
        os.close(fd)
    p = _state_json(PROGRESS_FILE)
    p = p.get("progress") if isinstance(p, dict) else None
    ok = isinstance(p, dict) and all(isinstance(p.get(k), int) and not isinstance(p.get(k), bool)
                                     and 0 <= p[k] <= 10 ** 8 for k in ("step", "of", "done", "total")) \
        and p["of"] <= 20 and 1 <= p["step"] <= p["of"] and p.get("doing") in STEP_TEXT.values()
    if not ok:
        return {"step": 0, "of": 0, "doing": "", "done": 0, "total": 0}
    out = {k: p[k] for k in ("step", "of", "doing", "done", "total")}
    at, span = p.get("at"), p.get("span")
    if all(isinstance(x, (int, float)) and not isinstance(x, bool) and 0 <= x <= 1 for x in (at, span)) \
            and at + span <= 1.0001:
        out["at"], out["span"] = at, span
    return out


def save_progress(body, force=False):
    """The latest progress, for a panel that did not start the run (after a
    shell restart, or on another monitor). At most every five seconds."""
    now = time.monotonic()
    if not force and now - PROGRESS["saved"] < 5.0:
        return
    PROGRESS["saved"] = now
    try:
        dirfd = _state_dir()
    except (OSError, Refused):
        return
    try:
        write_atomic(dirfd, PROGRESS_FILE, json.dumps({"progress": body}, separators=(",", ":")).encode())
    except OSError:
        pass
    finally:
        os.close(dirfd)


def progress(step, of, doing, done=0, total=0):
    """One progress line for the panel while a long refresh runs (only when asked for)."""
    body = {"step": step, "of": of, "doing": doing, "done": int(done), "total": int(total)}
    spans = PROGRESS.get("spans")
    if isinstance(spans, list) and len(spans) == of and 1 <= step <= of:
        body["at"], body["span"] = spans[step - 1]
    if RUN_LOCK["fd"] is not None:
        save_progress(body, force=done == 0)
    if PROGRESS["on"]:
        emit({"progress": body})


def emit(obj):
    """One JSON line to the panel. If the panel is gone (the shell restarted),
    the run carries on quietly instead of dying halfway."""
    if PROGRESS.get("gone"):
        return
    data = json.dumps(obj, separators=(",", ":"), ensure_ascii=True)
    try:
        sys.stdout.write(data + "\n")
        sys.stdout.flush()
    except (BrokenPipeError, OSError):
        PROGRESS["gone"] = True


def main(argv):
    os.umask(0o077)
    if len(argv) in (2, 3) and argv[1] == "audit" and argv[2:] in ([], ["--peek"]):
        try:
            os.nice(5)                     # a check every half hour should never slow what you are doing
        except OSError:
            pass
        # --peek: report only, leave the seen-findings state alone (used by bar
        # instances on secondary monitors so only one instance notifies).
        emit(audit(peek=len(argv) == 3))
        return 0
    if len(argv) == 3 and argv[1] == "fix" and re.fullmatch(r"[a-z][a-z0-9-]{0,31}", argv[2]):
        emit(run_fix(argv[2]))
        return 0
    if len(argv) == 3 and argv[1] in ("ignore", "unignore") and re.fullmatch(r"[0-9a-f]{16}", argv[2]):
        emit(set_ignored(argv[2], argv[1] == "ignore"))
        return 0
    if len(argv) == 3 and argv[1] in ("dismiss", "undismiss") and re.fullmatch(r"[a-z0-9-]{1,40}", argv[2]):
        emit(set_dismissed(argv[2], argv[1] == "dismiss"))
        return 0
    if len(argv) in (2, 3) and argv[1] == "refresh-feeds" and argv[2:] in (
            [], ["--force"], ["--sources"], ["--full"], ["--scan"], ["--daily"], ["--weekly"]):
        PROGRESS["on"] = True
        flag = argv[2] if len(argv) == 3 else ""
        if not take_run_lock():
            emit({"ok": True, "busy": True, "action": "",
                  "message": "Vigil is already running a scan or update. This one was not started."})
            return 0
        signal.signal(signal.SIGTERM, _on_stop)
        try:
            os.nice(10)                    # background work: never compete with what you are doing
        except OSError:
            pass
        save_run_info()
        emit(refresh_due_feeds(force=flag == "--force", sources_only=flag == "--sources", full=flag == "--full",
                               scan_only=flag == "--scan", daily_only=flag == "--daily",
                               weekly_only=flag == "--weekly"))
        return 0
    if len(argv) == 2 and argv[1] == "stop":
        emit(stop_run())
        return 0
    if len(argv) == 2 and argv[1] == "running":
        # Cheap: lets a panel follow a scan it did not start, without a full check.
        emit({"running": run_in_progress()})
        return 0
    if len(argv) == 2 and argv[1] == "version":
        emit({"version": VERSION})
        return 0
    sys.stderr.write("usage: vigil audit [--peek] | vigil fix <action> | vigil dismiss|undismiss <check> | vigil ignore|unignore <detection> | vigil refresh-feeds [--force|--sources|--daily|--weekly|--full|--scan] | vigil running | vigil stop | vigil version\n")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
