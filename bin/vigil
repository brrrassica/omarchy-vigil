                  why, weight=0)


# --- Care -------------------------------------------------------------------

def _dir_size(path, deadline):
    """Bytes under a directory, without following symlinks, within a budget."""
    total, count = 0, 0
    stack = [path]
    while stack and count < WALK_MAX_ENTRIES and time.monotonic() < deadline:
        cur = stack.pop()
        try:
            with os.scandir(cur) as it:
                for e in it:
                    count += 1
                    try:
                        if e.is_dir(follow_symlinks=False):
                            stack.append(e.path)
                        elif e.is_file(follow_symlinks=False):
                            total += e.stat(follow_symlinks=False).st_blocks * 512
                    except OSError:
                        pass
                    if count >= WALK_MAX_ENTRIES:
                        break
        except OSError:
            continue
    complete = not stack
    return total, complete


def human(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return ("%d %s" % (n, unit)) if unit == "B" else ("%.1f %s" % (n, unit))
        n /= 1024.0


def _size_check(cid, title, path, why, action, label, big):
    if not exists(path):
        return result(cid, "care", title, "pass", "Empty.", why, weight=0)
    size, complete = _dir_size(path, time.monotonic() + WALK_MAX_SECONDS)
    approx = "" if complete else "at least "
    status = "warn" if size >= big else "info"
    return result(cid, "care", title, status if size else "pass", "%s%s." % (approx, human(size)) if size else "Empty.",
                  why, fix=fix(*action, label) if size and action else None, weight=0)


@check
def check_thumbnails():
    return _size_check("thumbnails", "Thumbnail cache", home_path(".cache", "thumbnails"),
                       "Small previews of every image and video you have browsed. They can reveal files you "
                       "have since deleted.", ("helper", "clean-thumbnails"), "Clear", 512 * 1024 * 1024)


@check
def check_trash():
    return _size_check("trash", "Trash", home_path(".local", "share", "Trash"),
                       "Files you deleted from the file manager are kept here until the trash is emptied.",
                       ("helper", "empty-trash"), "Empty", 1024 * 1024 * 1024)


CACHE_UNUSED_DAYS = 7
CACHE_SKIP = {"thumbnails"}            # its own row and its own cleanup


def _cache_scan(dfd, cutoff, deadline, budget):
    """(total bytes, bytes in files unused since cutoff) below dfd, never following symlinks."""
    total = old = 0
    with os.scandir(dfd) as it:
        entries = list(it)[:max(0, budget[0])]
    for e in entries:
        budget[0] -= 1
        if budget[0] <= 0 or time.monotonic() > deadline:
            break
        try:
            if e.is_dir(follow_symlinks=False):
                sub = os.open(e.name, O_DIR, dir_fd=dfd)
                try:
                    t, o = _cache_scan(sub, cutoff, deadline, budget)
                finally:
                    os.close(sub)
                total, old = total + t, old + o
            elif e.is_file(follow_symlinks=False):
                st = e.stat(follow_symlinks=False)
                size = st.st_blocks * 512
                total += size
                if st.st_uid == os.geteuid() and max(st.st_atime, st.st_mtime) < cutoff:
                    old += size
        except OSError:
            continue
    return total, old


def _cache_cutoff():
    return time.time() - CACHE_UNUSED_DAYS * 86400


@check
def check_user_cache():
    cid, cat, title = "user-cache", "care", "Application caches"
    why = ("Browsers and apps keep caches in ~/.cache and rebuild them when needed, so this is "
           "about disk space.")
    try:
        dfd = _open_home_dir([".cache"])
    except (OSError, Refused):
        return result(cid, cat, title, "pass", "Empty.", why, weight=0)
    try:
        total = old = 0
        budget = [WALK_MAX_ENTRIES]
        deadline = time.monotonic() + WALK_MAX_SECONDS
        with os.scandir(dfd) as it:
            tops = [e.name for e in it if e.name not in CACHE_SKIP]
        for name in tops:
            try:
                st = os.stat(name, dir_fd=dfd, follow_symlinks=False)
                if stat.S_ISDIR(st.st_mode):
                    sub = os.open(name, O_DIR, dir_fd=dfd)
                    try:
                        t, o = _cache_scan(sub, _cache_cutoff(), deadline, budget)
                    finally:
                        os.close(sub)
                elif stat.S_ISREG(st.st_mode):
                    t = st.st_blocks * 512
                    o = t if st.st_uid == os.geteuid() and max(st.st_atime, st.st_mtime) < _cache_cutoff() else 0
                else:
                    continue
            except OSError:
                continue
            total, old = total + t, old + o
    finally:
        os.close(dfd)
    if not total:
        return result(cid, cat, title, "pass", "Empty.", why, weight=0)
    if old < 1024 * 1024:
        return result(cid, cat, title, "pass", "%s, all of it in use." % human(total), why, weight=0)
    return result(cid, cat, title, "warn" if old >= 5 * 1024 ** 3 else "info",
                  "%s; %s not used in the past week." % (human(total), human(old)), why,
                  fix=fix("helper", "clean-app-cache", "Clear unused"), weight=0)


_UNITS = {"B": 1, "KiB": 1024, "MiB": 1024 ** 2, "GiB": 1024 ** 3, "TiB": 1024 ** 4}
_PACCACHE_SAVED = re.compile(r"disk space saved: ([0-9]+(?:\.[0-9]+)?) (B|KiB|MiB|GiB|TiB)\)")


def _paccache_freeable():
    """Bytes `paccache -rk2` plus `paccache -ruk0` would free, from dry runs; None if unknown."""
    tool = "/usr/bin/paccache"
    if not is_trusted_executable(sys_path(tool)):
        return None
    total = 0
    for args in (["-d", "-k2"], ["-d", "-u", "-k0"]):
        rc, out = run([tool] + args + ["--nocolor"], timeout=20, limit=CMD_MAX)
        if rc != 0:
            return None
        if "no candidate packages found" in out:
            continue
        m = _PACCACHE_SAVED.search(out)
        if not m:
            return None
        total += int(float(m.group(1)) * _UNITS[m.group(2)])
    return total


@check
def check_pacman_cache():
    cid, cat, title = "pacman-cache", "care", "Package cache"
    why = ("Every package version pacman downloaded. Omarchy keeps the two newest of each so a bad update can "
           "be rolled back; Vigil keeps those and frees the rest, including packages you have since removed.")
    path = sys_path("/var/cache/pacman/pkg")
    if not exists(path):
        return result(cid, cat, title, "pass", "Empty.", why, weight=0)
    size, complete = _dir_size(path, time.monotonic() + WALK_MAX_SECONDS)
    if not size:
        return result(cid, cat, title, "pass", "Empty.", why, weight=0)
    shown = ("" if complete else "at least ") + human(size)
    free = _paccache_freeable()
    if free is None:
        return result(cid, cat, title, "unknown", "%s. Could not work out how much can be freed." % shown, why,
                      weight=0)
    if free < 1024 * 1024:
        return result(cid, cat, title, "pass", "%s, all of it kept for rollback." % shown, why, weight=0)
    return result(cid, cat, title, "warn" if free >= 2 * 1024 ** 3 else "info",
                  "%s; %s can be freed." % (shown, human(free)), why,
                  fix=fix("terminal", "clean-pacman-cache", "Free %s" % human(free)), weight=0)


@check
def check_orphans():
    cid, cat, title = "orphans", "care", "Orphaned packages"
    why = ("Packages that were installed as dependencies of something you have since removed. They still "
           "get updates and still count as installed software.")
    tool = "/usr/bin/pacman"
    if not is_trusted_executable(sys_path(tool)):
        return result(cid, cat, title, "na", "pacman is not available.", why, weight=0)
    rc, out = run([tool, "-Qdtq"], timeout=8, limit=CMD_MAX)
    if rc is None:
        return result(cid, cat, title, "unknown", "Could not list orphaned packages.", why, weight=0)
    names = out.split()
    if not names:
        return result(cid, cat, title, "pass", "None.", why, weight=0)
    return result(cid, cat, title, "info", "%d orphaned package%s." % (len(names), "" if len(names) == 1 else "s"),
                  why, clean_block(names), fix("terminal", "clean-orphans", "Review and remove"), weight=0)


@check
def check_journal():
    cid, cat, title = "journal", "care", "System logs"
    why = "The system journal keeps logs of everything that happened, which is useful but grows over time."
    tool = "/usr/bin/journalctl"
    if not is_trusted_executable(sys_path(tool)):
        return result(cid, cat, title, "na", "journalctl is not available.", why, weight=0)
    rc, out = run([tool, "--disk-usage"], timeout=6, limit=4096)
    m = re.search(r"take up ([0-9.]+[KMGT]?B?)", out or "")
    if rc is None or not m:
        return result(cid, cat, title, "unknown", "Could not read the journal size.", why, weight=0)
    return result(cid, cat, title, "info", "Logs take up %s." % clean(m.group(1), 20), why,
                  fix=fix("terminal", "clean-journal", "Keep two weeks"), weight=0)


# ---------------------------------------------------------------------------
# Undo: files in /etc that Vigil's terminal actions wrote. A file counts as
# Vigil's only while its first line is exactly ETC_MARK (Model.js writes the
# same line), so a file someone has since rewritten is never offered for undo.

ETC_MARK = "# Written by Vigil (keasbeexd.vigil). Delete this file to undo."

UNDO_FILES = {
    "undo-sysctl": "/etc/sysctl.d/90-omarchy-vigil.conf",
    "undo-llmnr": "/etc/systemd/resolved.conf.d/90-omarchy-vigil-llmnr.conf",
    "undo-dns-fallback": "/etc/systemd/resolved.conf.d/90-omarchy-vigil-fallback.conf",
    "undo-sshd": "/etc/ssh/sshd_config.d/00-omarchy-vigil.conf",
    "undo-connectivity": "/etc/NetworkManager/conf.d/90-omarchy-vigil-connectivity.conf",
    "undo-mac": "/etc/NetworkManager/conf.d/90-omarchy-vigil-mac.conf",
    "undo-protocols": "/etc/modprobe.d/90-omarchy-vigil-protocols.conf",
    "undo-firewire": "/etc/modprobe.d/90-omarchy-vigil-firewire.conf",
}
AVAHI_BACKUP = "/etc/avahi/avahi-daemon.conf.vigil-backup"

# Undo through Omarchy's own removal commands, for what Omarchy set up.
TOOL_UNDO = {"undo-fingerprint": "omarchy-remove-security-fingerprint",
             "undo-fido2": "omarchy-remove-security-fido2"}

CHECK_UNDO = {
    "kernel-hardening": "undo-sysctl", "network-hardening": "undo-sysctl", "llmnr": "undo-llmnr",
    "dns-fallback": "undo-dns-fallback", "ssh-server": "undo-sshd", "connectivity-check": "undo-connectivity",
    "mac-address": "undo-mac", "avahi": "undo-avahi", "rare-protocols": "undo-protocols",
    "firewire": "undo-firewire",
}


def vigil_owned(path):
    """True when the file's first line is exactly Vigil's marker."""
    try:
        data = read_file(sys_path(path), SMALL_FILE_MAX)
    except Refused:
        return False
    if data is None:
        return False
    return data.split(b"\n", 1)[0].decode("utf-8", "replace") == ETC_MARK


def undo_available(action):
    if action == "undo-avahi":
        try:
            st = os.lstat(sys_path(AVAHI_BACKUP))
        except OSError:
            return False
        return stat.S_ISREG(st.st_mode)
    path = UNDO_FILES.get(action)
    return bool(path) and vigil_owned(path)


# Any finding that is not passing can be marked as reviewed: it stops counting
# and stays reviewed through later checks. For these, which report evidence
# (what was found, not a setting), a review covers what was found then; if
# something new turns up, the finding comes back.
EVIDENCE_CHECKS = {"open-ports", "persistence", "file-changes", "exposed-secrets", "malicious-packages",
                   "virus-scan", "ld-preload", "bumblebee", "scanner-arch-audit", "aur-status",
                   "omarchy-plugins", "aur-packages", "accounts", "shell-history", "old-services"}


def dismissible(c):
    return c["status"] not in ("pass", "na")


# ---------------------------------------------------------------------------
# State: previously seen findings and a short score history

def _state_dir():
    return _open_home_dir(list(STATE_DIR), create=True)


def _remove_state_file(name):
    """Delete one of Vigil's own files from the state folder, relative to the
    held folder; a link of that name is removed, never followed."""
    try:
        dirfd = _state_dir()
    except (OSError, Refused):
        return
    try:
        os.unlink(name, dir_fd=dirfd)
    except OSError:
        pass
    finally:
        os.close(dirfd)


def _read_state(dirfd):
    try:
        fd = os.open(STATE_NAME, O_READ | os.O_NOFOLLOW, dir_fd=dirfd)
    except FileNotFoundError:
        return {}
    except OSError:
        raise Refused("state file is not a regular file")
    try:
        st = os.fstat(fd)
        if st.st_uid != os.geteuid() or st.st_nlink != 1:
            raise Refused("state file is not ours")
        raw = _read_fd(fd, STATE_FILE_MAX)
    finally:
        os.close(fd)
    try:
        data = json.loads(raw.decode("utf-8"))
    except ValueError:
        return {}
    return data if isinstance(data, dict) else {}


def write_atomic(dirfd, name, data, mode=0o600):
    tmp = ".%s.%s.tmp" % (name, secrets.token_hex(8))
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, mode, dir_fd=dirfd)
    try:
        os.fchmod(fd, mode)
        view = memoryview(data)
        while view:
            n = os.write(fd, view)
            view = view[n:]
        os.fsync(fd)
        os.rename(tmp, name, src_dir_fd=dirfd, dst_dir_fd=dirfd)
        os.fsync(dirfd)
    except BaseException:
        try:
            os.unlink(tmp, dir_fd=dirfd)
        except OSError:
            pass
        raise
    finally:
        os.close(fd)


def _lock(dirfd):
    """Serialise state read-modify-write between the panel's audits and
    dismiss/undismiss. flock on the held directory descriptor itself, so there
    is no separate lock file to plant a symlink at."""
    fcntl.flock(dirfd, fcntl.LOCK_EX)


def load_state():
    """The state file, read-only; {} when it does not exist or is not ours."""
    try:
        dirfd = _open_home_dir(list(STATE_DIR))
    except (OSError, Refused):
        return {}
    try:
        return _read_state(dirfd)
    except Refused:
        return {}
    finally:
        os.close(dirfd)


_DATE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
_FP = re.compile(r"^[a-z0-9-]{1,40}:[0-9a-f]{12}$")


def state_dismissed(state):
    """{fingerprint: date} from the state, validated and capped."""
    out = {}
    for d in state.get("dismissed", [])[:SEEN_MAX] if isinstance(state.get("dismissed"), list) else []:
        if isinstance(d, dict) and isinstance(d.get("fp"), str) and _FP.match(d["fp"]):
            at = d.get("at") if isinstance(d.get("at"), str) and _DATE.match(d.get("at")) else ""
            out[d["fp"]] = at
    return out


def state_history(state):
    """One entry per day, oldest first: [{"date", "score"}], at most HISTORY_MAX."""
    days = {}
    for h in state.get("history", []) if isinstance(state.get("history"), list) else []:
        if not isinstance(h, dict):
            continue
        at, score = h.get("at"), h.get("score")
        if not isinstance(at, str) or isinstance(score, bool) or not isinstance(score, int) or not 0 <= score <= 100:
            continue
        date = at[:10]
        if _DATE.match(date):
            days[date] = score          # later entries for the same day win
    return [{"date": d, "score": days[d]} for d in sorted(days)][-HISTORY_MAX:]


def fingerprint(c):
    """What a review covers: the check and its status, plus what was found for evidence checks."""
    basis = c["status"]
    if c["id"] in EVIDENCE_CHECKS:
        basis += "\n" + (c["detail"] or c["summary"])
    return c["id"] + ":" + hashlib.sha256(basis.encode()).hexdigest()[:12]


def update_state(report):
    """Record findings and today's score; return (new finding ids, saved)."""
    try:
        dirfd = _state_dir()
    except (OSError, Refused):
        return [], False
    try:
        _lock(dirfd)
        try:
            state = _read_state(dirfd)
        except Refused:
            return [], False
        seen = set(s for s in state.get("seen", []) if isinstance(s, str))
        dismissed = state_dismissed(state)
        current = [fingerprint(c) for c in report["checks"] if c["status"] in ("fail", "warn") and c["weight"] > 0]
        first_run = "seen" not in state
        new = [] if first_run else [f.split(":", 1)[0] for f in current if f not in seen and f not in dismissed]
        history = state_history(state)
        today = report["generatedAt"][:10]
        history = [h for h in history if h["date"] != today] + [{"date": today, "score": report["score"]}]
        out = {
            "schema": SCHEMA, "seen": current[:SEEN_MAX],
            "dismissed": [{"fp": f, "at": a} for f, a in list(dismissed.items())[-SEEN_MAX:]],
            "history": [{"at": h["date"], "score": h["score"]} for h in history[-HISTORY_MAX:]],
        }
        try:
            write_atomic(dirfd, STATE_NAME, json.dumps(out, separators=(",", ":")).encode())
        except OSError:
            return sorted(set(new))[:LIST_MAX], False
        report["history"] = history[-HISTORY_MAX:]
        return sorted(set(new))[:LIST_MAX], True
    finally:
        os.close(dirfd)


def mark_seen(fp):
    """Add one finding fingerprint to the seen list, so it does not notify."""
    try:
        dirfd = _state_dir()
    except (OSError, Refused):
        return
    try:
        _lock(dirfd)
        try:
            state = _read_state(dirfd)
        except Refused:
            return
        seen = [x for x in state.get("seen", []) if isinstance(x, str) and x != fp]
        state["seen"] = (seen + [fp])[-SEEN_MAX:]
        state["schema"] = SCHEMA
        try:
            write_atomic(dirfd, STATE_NAME, json.dumps(state, separators=(",", ":")).encode())
        except OSError:
            pass
    finally:
        os.close(dirfd)


def set_dismissed(check_id, on):
    """Mark the current warning of `check_id` as reviewed, or show it again."""
    report = audit(peek=True)
    c = next((x for x in report["checks"] if x["id"] == check_id), None)
    if c is None:
        return {"ok": False, "action": "", "message": "Unknown check."}
    try:
        dirfd = _state_dir()
    except (OSError, Refused):
        return {"ok": False, "action": "", "message": "Could not open Vigil's state folder."}
    try:
        _lock(dirfd)
        try:
            state = _read_state(dirfd)
        except Refused as e:
            return {"ok": False, "action": "", "message": clean("Refused: %s" % e)}
        dismissed = state_dismissed(state)
        if on:
            if not dismissible(c):
                return {"ok": False, "action": "", "message": "This finding cannot be marked as reviewed."}
            dismissed[fingerprint(c)] = report["generatedAt"][:10]
            msg = ("Marked as reviewed. It no longer counts, and comes back only if something new is found."
                   if c["id"] in EVIDENCE_CHECKS else "Marked as reviewed. It no longer counts.")
        else:
            dismissed = {f: a for f, a in dismissed.items() if f.split(":", 1)[0] != check_id}
            msg = "Showing it again."
        state["dismissed"] = [{"fp": f, "at": a} for f, a in list(dismissed.items())[-SEEN_MAX:]]
        state["schema"] = SCHEMA
        try:
            write_atomic(dirfd, STATE_NAME, json.dumps(state, separators=(",", ":")).encode())
        except OSError:
            return {"ok": False, "action": "", "message": "Could not save."}
        return {"ok": True, "action": "", "message": msg}
    finally:
        os.close(dirfd)


# ---------------------------------------------------------------------------
# Audit

def score_of(checks):
    score = 100
    for c in checks:
        if c.get("dismissed"):
            continue
        w = c["weight"]
        if c["status"] == "fail":
            score -= 10 * w
        elif c["status"] == "warn":
            score -= 2 * w
    return max(0, min(100, score))


UNKNOWN_HOWTO = ("Vigil could not finish this check. Press R to check again; if it keeps happening, "
                 "mark it as reviewed.")

# For findings Vigil cannot fix itself: how to fix it, and a button that
# helps (a read-only command in a terminal, or a maintained guide).
CHECK_HELP = {
    "ssh-keys": ("Make ~/.ssh a normal folder owned by you, not a link, then press R.",
                 ("docs", "arch-ssh-keys", "Learn more")),
    "gnupg": ("Make ~/.gnupg a normal folder owned by you, not a link, then press R.",
              ("docs", "arch-gnupg", "Learn more")),
    "disk-encryption": ("Encryption can only be turned on when installing: back up, then reinstall Omarchy "
                        "with encryption on. If this machine never leaves home, mark it as reviewed.",
