#!/usr/bin/python3 -I -S
"""Vigil helper: the unprivileged half of the Vigil security suite.

The bar widget runs this file as an argv array,

    /usr/bin/python3 -I -S <plugin>/bin/vigil audit
    /usr/bin/python3 -I -S <plugin>/bin/vigil fix <action-id>

with a cleared environment, and reads exactly one JSON object from stdout.

Rules this file keeps (they follow the marketplace review guidance):

- It never asks for root. Everything it reads is readable by the logged-in
  account; anything that needs root is done by Omarchy's own commands or by a
  constant command the user watches run in a terminal (see Panel.qml).
- Every child process is an absolute path, runs in its own session with a
  minimal environment, has a hard deadline, and has its output capped at the
  producer (cap + 1 bytes, overflow is an error, not a truncation).
- Files are opened once, through a descriptor that is fstat-validated
  (regular file, size cap) before reading; writes go to an exclusive random
  temporary that is 0600 from creation, then fsync + rename + directory fsync.
  Directories that Vigil writes into are walked one component at a time with
  O_NOFOLLOW from the home directory.
- Output strings are control-character-free and length-capped; counts are
  capped. The QML side applies the same limits again.

Standard library only. No network access of any kind.
"""
import errno
import fcntl
import zlib
import hashlib
import json
import os
import pwd
import re
import secrets
import selectors
import signal
import stat
import subprocess
import sys
import time
from base64 import b64decode

VERSION = "0.13.0"
PLUGIN_ID = "keasbeexd.vigil"
SCHEMA = 1

# ---------------------------------------------------------------------------
# Where things live. Constants, not settings: tests replace them on the
# imported module, which is the only way they change.

ROOT = ""                       # filesystem prefix for /etc, /proc, /sys, /var
try:
    HOME = pwd.getpwuid(os.geteuid()).pw_dir
except KeyError:
    HOME = "/nonexistent"
USER = ""
try:
    USER = pwd.getpwuid(os.geteuid()).pw_name
except KeyError:
    pass

STATE_DIR = (".local", "state", "omarchy-vigil")
STATE_NAME = "state.json"
BASELINE_NAME = "baseline.json"
STATE_FILE_MAX = 256 * 1024
PLUGIN_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
OPT_OUT_DIR = (".config", "uwsm", "env.d")
OPT_OUT_NAME = "90-omarchy-vigil-opt-out"

# Directories an Omarchy command may live in. Only root-owned, non-writable
# files here are ever reported as usable.
TRUSTED_BIN_DIRS = ("/usr/bin", "/usr/share/omarchy/bin")

SAFE_PATH = "/usr/bin:/bin"

# Bounds.
FILE_MAX = 1024 * 1024           # any config or log read
SMALL_FILE_MAX = 64 * 1024
PACMAN_LOG_TAIL = 2 * 1024 * 1024
CMD_MAX = 256 * 1024
CMD_TIMEOUT = 8
STR_MAX = 240
DETAIL_MAX = 1200
LIST_MAX = 40
WALK_MAX_ENTRIES = 200000
WALK_MAX_SECONDS = 3.0
HISTORY_MAX = 30
SEEN_MAX = 200

O_READ = os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC
O_DIR = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC


class Refused(Exception):
    """A file or directory failed validation; treated as unreadable."""


# ---------------------------------------------------------------------------
# Text hygiene

_CONTROL = re.compile("[\x00-\x08\x0b-\x1f\x7f-\x9f‎‏‪-‮⁦-⁩]")


def clean(value, limit=STR_MAX):
    """Strip control and bidi characters, collapse tabs, cap the length."""
    s = str(value if value is not None else "")
    s = _CONTROL.sub(" ", s.replace("\t", " "))
    if len(s) > limit:
        s = s[: limit - 1] + "…"
    return s.strip()


def clean_block(lines, limit=DETAIL_MAX):
    out = "\n".join(clean(x, STR_MAX) for x in lines[:LIST_MAX])
    if len(lines) > LIST_MAX:
        out += "\n… and %d more" % (len(lines) - LIST_MAX)
    return out[:limit]


# ---------------------------------------------------------------------------
# Reading files

def sys_path(path):
    """Map an absolute system path under the (test) ROOT prefix."""
    return ROOT + path


def home_path(*parts):
    return os.path.join(HOME, *parts)


def _read_fd(fd, limit):
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode):
        raise Refused("not a regular file")
    os.set_blocking(fd, True)
    chunks = []
    total = 0
    while total <= limit:
        chunk = os.read(fd, min(65536, limit + 1 - total))
        if not chunk:
            break
        chunks.append(chunk)
        total += len(chunk)
    if total > limit:
        raise Refused("file is larger than %d bytes" % limit)
    return b"".join(chunks)


def read_file(path, limit=FILE_MAX, follow=False):
    """Return the bytes of a file, None if it does not exist.

    One open, then fstat and a bounded read on that same descriptor.
    O_NONBLOCK keeps a planted FIFO from hanging the open. By default the
    final component must not be a symlink. `follow=True` is used only for
    audit reads of shell startup files, where refusing a symlink would let
    a dotfile hide from the persistence scan; those reads still refuse
    anything that is not a regular file and still enforce the size cap.
    Raises Refused for anything else that cannot be read safely.
    """
    flags = O_READ if follow else (O_READ | os.O_NOFOLLOW)
    try:
        fd = os.open(path, flags)
    except FileNotFoundError:
        return None
    except NotADirectoryError:
        return None
    except OSError as e:
        if e.errno == errno.ELOOP:
            raise Refused("is a symbolic link")
        raise Refused(os.strerror(e.errno or 0) or "cannot open")
    try:
        return _read_fd(fd, limit)
    finally:
        os.close(fd)


def read_text(path, limit=FILE_MAX, follow=False):
    data = read_file(path, limit, follow)
    if data is None:
        return None
    return data.decode("utf-8", "replace")


def read_tail(path, limit):
    """Last `limit` bytes of a (possibly large) log file, via one descriptor."""
    try:
        fd = os.open(path, O_READ | os.O_NOFOLLOW)
    except FileNotFoundError:
        return None
    except OSError as e:
        raise Refused(os.strerror(e.errno or 0) or "cannot open")
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise Refused("not a regular file")
        os.set_blocking(fd, True)
        start = max(0, st.st_size - limit)
        os.lseek(fd, start, os.SEEK_SET)
        chunks, total = [], 0
        while total < limit:
            chunk = os.read(fd, min(65536, limit - total))
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
        return b"".join(chunks).decode("utf-8", "replace")
    finally:
        os.close(fd)


def list_dir(path, limit=500):
    """Sorted names in a directory, capped before sorting. [] if absent."""
    try:
        fd = os.open(path, O_DIR)
    except (FileNotFoundError, NotADirectoryError):
        return []
    except OSError:
        return []
    names = []
    try:
        with os.scandir(fd) as it:
            for entry in it:
                names.append(entry.name)
                if len(names) >= limit:
                    break
    finally:
        os.close(fd)
    return sorted(names)


def exists(path):
    try:
        os.lstat(path)
        return True
    except OSError:
        return False


def is_trusted_executable(path):
    """Root-owned regular file, not group/world writable, in a root-owned dir."""
    try:
        st = os.lstat(path)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022:
            return False
        if not st.st_mode & 0o111:
            return False
        dst = os.stat(os.path.dirname(path))
        return dst.st_uid == 0 and not dst.st_mode & 0o022
    except OSError:
        return False


def find_tool(name):
    """Absolute path of a root-owned tool in a fixed directory, or ''."""
    for d in TRUSTED_BIN_DIRS:
        p = sys_path(d + "/" + name)
        if is_trusted_executable(p):
            return d + "/" + name
    return ""


# ---------------------------------------------------------------------------
# Running commands

SAFE_ENV = {"PATH": SAFE_PATH, "HOME": HOME, "LC_ALL": "C", "LANG": "C"}


def _kill_group(proc):
    for sig in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(proc.pid, sig)
        except (OSError, ProcessLookupError):
            return
        try:
            proc.wait(timeout=0.5)
            return
        except subprocess.TimeoutExpired:
            continue


def run(argv, timeout=CMD_TIMEOUT, limit=CMD_MAX):
    """Run an absolute argv; return (returncode, stdout_text) or (None, '').

    Own session, scrubbed env, deadline, stdout read incrementally against a
    byte budget, stderr discarded. Overflow and timeout both return None.
    """
    if not argv or not argv[0].startswith("/"):
        return None, ""
    try:
        proc = subprocess.Popen(
            argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL, env=dict(SAFE_ENV, HOME=HOME),
            start_new_session=True, close_fds=True,
        )
    except OSError:
        return None, ""
    buf = bytearray()
    deadline = time.monotonic() + timeout
    ok = False
    sel = selectors.DefaultSelector()
    try:
        sel.register(proc.stdout, selectors.EVENT_READ)
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0 or not sel.select(remaining):
                break
            chunk = os.read(proc.stdout.fileno(), 65536)
            if not chunk:
                ok = True
                break
            buf += chunk
            if len(buf) > limit:
                break
    except OSError:
        pass
    finally:
        sel.close()
        if ok:
            try:
                proc.wait(timeout=max(0.1, deadline - time.monotonic()))
            except subprocess.TimeoutExpired:
                ok = False
        if proc.poll() is None:
            _kill_group(proc)
        try:
            proc.stdout.close()
        except OSError:
            pass
    if not ok or len(buf) > limit:
        return None, ""
    return proc.returncode, buf.decode("utf-8", "replace")


_SYSTEMCTL_MEMO = {}


def systemctl(*args):
    """`systemctl <args>` → first output word ('' when unknown). Memoised per audit."""
    if args in _SYSTEMCTL_MEMO:
        return _SYSTEMCTL_MEMO[args]
    _SYSTEMCTL_MEMO[args] = _systemctl(*args)
    return _SYSTEMCTL_MEMO[args]


def _systemctl(*args):
    tool = "/usr/bin/systemctl"
    if not is_trusted_executable(sys_path(tool)):
        return ""
    rc, out = run([tool] + list(args), timeout=4, limit=4096)
    if rc is None:
        return ""
    words = out.split()
    return words[0] if words else ""


# ---------------------------------------------------------------------------
# Config parsing helpers

def parse_kv(text, sep="="):
    """Simple KEY=VALUE parser for shell-ish and systemd-ish files."""
    out = {}
    for line in (text or "").splitlines():
        line = line.strip()
        if not line or line[0] in "#;" or sep not in line:
            continue
        k, v = line.split(sep, 1)
        out[k.strip()] = v.strip().strip('"').strip("'")
    return out


def parse_ini(text):
    """Minimal INI: {section: {key: value}}; later keys win."""
    data, section = {}, ""
    for raw in (text or "").splitlines():
        line = raw.strip()
        if not line or line[0] in "#;":
            continue
        if line.startswith("[") and line.endswith("]"):
            section = line[1:-1].strip()
            data.setdefault(section, {})
            continue
        if "=" in line:
            k, v = line.split("=", 1)
            data.setdefault(section, {})[k.strip()] = v.strip()
    return data


def merged_ini(paths):
    """Merge INI files in order; later files win key by key."""
    merged = {}
    for p in paths:
        try:
            text = read_text(p)
        except Refused:
            continue
        for section, kv in parse_ini(text).items():
            merged.setdefault(section, {}).update(kv)
    return merged


def conf_d(dirpath, suffix=".conf"):
    return [dirpath + "/" + n for n in list_dir(dirpath) if n.endswith(suffix)]


# ---------------------------------------------------------------------------
# Checks
#
# Each check returns a dict:
#   id        stable identifier
#   category  harden | detect | supply | privacy | care
#   title     short name
#   status    pass | warn | fail | info | na | unknown
#   summary   one plain-language sentence about the current state
#   detail    optional multi-line evidence
#   why       one or two sentences on why it matters, for people new to this
#   fix       {"kind": "terminal"|"helper"|"app"|"none", "action": id, "label": str}
#   weight    0 (not scored) .. 3

CHECKS = []


def check(fn):
    CHECKS.append(fn)
    return fn


def result(id, category, title, status, summary, why="", detail="", fix=None, weight=1, howto=""):
    return {
        "id": id, "category": category, "title": title, "status": status,
        "summary": summary, "why": why, "detail": detail, "howto": howto,
        "fix": fix or {"kind": "none", "action": "", "label": ""},
        "weight": weight,
    }


def fix(kind, action, label):
    return {"kind": kind, "action": action, "label": label}


# --- Harden -----------------------------------------------------------------

@check
def check_firewall():
    cid, cat, title = "firewall", "harden", "Firewall"
    why = ("A firewall drops connections from other machines that you did not ask for. "
           "On café or office Wi-Fi it is what stands between your open ports and strangers.")
    try:
        conf = parse_kv(read_text(sys_path("/etc/ufw/ufw.conf")) or "")
        defaults = parse_kv(read_text(sys_path("/etc/default/ufw")) or "")
    except Refused as e:
        return result(cid, cat, title, "unknown", "Could not read the firewall settings: %s" % e, why, weight=3)
    have_ufw = exists(sys_path("/usr/bin/ufw"))
    if not have_ufw:
        for unit in ("nftables.service", "firewalld.service"):
            if systemctl("is-active", unit) == "active":
                return result(cid, cat, title, "pass", "%s is running." % unit.split(".")[0], why, weight=3)
        return result(cid, cat, title, "fail", "No firewall is installed.", why,
                      fix=fix("terminal", "install-ufw", "Install ufw"), weight=3)
    enabled = conf.get("ENABLED", "").lower() == "yes"
    active = systemctl("is-active", "ufw.service") == "active"
    policy = defaults.get("DEFAULT_INPUT_POLICY", "").upper()
    detail = "ENABLED=%s in /etc/ufw/ufw.conf\nufw.service: %s\nDefault for incoming: %s" % (
        conf.get("ENABLED", "?"), "active" if active else "not active", policy or "?")
    if not enabled or not active:
        return result(cid, cat, title, "fail", "ufw is installed but switched off.", why, detail,
                      fix("terminal", "firewall-on", "Turn the firewall on"), weight=3)
    if policy not in ("DROP", "REJECT"):
        return result(cid, cat, title, "warn", "ufw is on but lets incoming connections in by default.",
                      why, detail, fix("terminal", "firewall-deny-in", "Deny incoming by default"), weight=3)
    return result(cid, cat, title, "pass", "ufw is on and refuses incoming connections by default.", why, detail, weight=3)


def _sysctl(name):
    try:
        text = read_text(sys_path("/proc/sys/" + name.replace(".", "/")), SMALL_FILE_MAX)
    except Refused:
        return None
    if text is None:
        return None
    return text.strip()


KERNEL_SYSCTLS = [
    # name, test, recommended, plain explanation
    ("kernel.kptr_restrict", lambda v: v >= 1, 2, "hides kernel memory addresses from programs"),
    ("kernel.dmesg_restrict", lambda v: v == 1, 1, "keeps the kernel log away from normal programs"),
    ("kernel.yama.ptrace_scope", lambda v: v >= 1, 1, "stops programs reading each other's memory"),
    ("kernel.unprivileged_bpf_disabled", lambda v: v >= 1, 2, "blocks a common kernel attack surface"),
    ("fs.protected_symlinks", lambda v: v == 1, 1, "blocks symlink tricks in shared folders"),
    ("fs.protected_hardlinks", lambda v: v == 1, 1, "blocks hardlink tricks in shared folders"),
    ("fs.protected_fifos", lambda v: v >= 1, 2, "blocks FIFO tricks in shared folders"),
    ("fs.protected_regular", lambda v: v >= 1, 2, "blocks file tricks in shared folders"),
    ("fs.suid_dumpable", lambda v: v == 0, 0, "stops privileged programs leaving memory dumps"),
]

NETWORK_SYSCTLS = [
    ("net.ipv4.conf.all.accept_redirects", lambda v: v == 0, 0, "ignores route changes sent by other machines"),
    ("net.ipv6.conf.all.accept_redirects", lambda v: v == 0, 0, "ignores IPv6 route changes sent by other machines"),
    ("net.ipv4.conf.all.send_redirects", lambda v: v == 0, 0, "this laptop is not a router"),
    ("net.ipv4.conf.all.accept_source_route", lambda v: v == 0, 0, "refuses packets that pick their own route"),
    ("net.ipv4.tcp_syncookies", lambda v: v == 1, 1, "survives connection floods"),
    ("net.ipv4.conf.all.rp_filter", lambda v: v in (1, 2), 2, "drops packets with spoofed source addresses"),
    ("net.ipv4.icmp_echo_ignore_broadcasts", lambda v: v == 1, 1, "ignores broadcast pings (smurf attacks)"),
]


def _sysctl_check(cid, title, table, why, action, weight):
    bad, lines, unknown = [], [], 0
    for name, test, rec, plain in table:
        raw = _sysctl(name)
        try:
            val = int(raw.split()[0]) if raw else None
        except (ValueError, IndexError):
            val = None
        if val is None:
            unknown += 1
            continue
        ok = test(val)
        lines.append("%s %s = %d (recommended %d): %s" % ("ok " if ok else "!! ", name, val, rec, plain))
        if not ok:
            bad.append(name)
    if unknown == len(table):
        return result(cid, "harden", title, "unknown", "Could not read the kernel settings.", why, weight=weight)
    detail = clean_block(lines, 2000)
    if bad:
        return result(cid, "harden", title, "warn",
                      "%d of %d protections are off." % (len(bad), len(table) - unknown),
                      why, detail, fix("terminal", action, "Apply recommended settings"), weight)
    return result(cid, "harden", title, "pass", "All %d protections are on." % (len(table) - unknown), why, detail, weight=weight)


@check
def check_kernel_sysctl():
    return _sysctl_check(
        "kernel-hardening", "Kernel self-protection", KERNEL_SYSCTLS,
        "These kernel switches make it harder for a program that is already running on your "
        "machine to spy on other programs or attack the kernel to become root.",
        "sysctl-harden", 2)


@check
def check_network_sysctl():
    return _sysctl_check(
        "network-hardening", "Network stack", NETWORK_SYSCTLS,
        "These switches make the network stack ignore tricks other machines on the same "
        "network can use to redirect or spoof your traffic.",
        "sysctl-harden", 1)


def _resolved_config():
    paths = conf_d(sys_path("/usr/lib/systemd/resolved.conf.d"))
    paths.append(sys_path("/etc/systemd/resolved.conf"))
    paths += conf_d(sys_path("/etc/systemd/resolved.conf.d"))
    return merged_ini(paths).get("Resolve", {})


def _modprobe_text():
    """Text of /etc/modprobe.conf and /etc/modprobe.d/*."""
    parts = []
    try:
        data = read_file(sys_path("/etc/modprobe.conf"), SMALL_FILE_MAX)
        if data:
            parts.append(data.decode("utf-8", "replace"))
    except Refused:
        pass
    try:
        names = sorted(os.listdir(sys_path("/etc/modprobe.d")))[:200]
    except OSError:
        names = []
    for n in names:
        try:
            data = read_file(sys_path("/etc/modprobe.d/" + n), SMALL_FILE_MAX)
        except Refused:
            continue
        if data:
            parts.append(data.decode("utf-8", "replace"))
    return "\n".join(parts)


@check
def check_rare_protocols():
    """Shown only where an earlier Vigil turned these protocols off, so the change can be undone.
    Vigil no longer suggests it: the gain on a personal computer is too small to explain."""
    cid, cat, title = "rare-protocols", "harden", "Rarely used network protocols"
    if not vigil_owned(UNDO_FILES["undo-protocols"]):
        return None
    return result(cid, cat, title, "pass", "Turned off by Vigil.",
                  "Vigil turned off DCCP, SCTP, RDS and TIPC, network protocols almost no desktop uses.", weight=0)


def _has_firewire_port():
    try:
        devs = os.listdir(sys_path("/sys/bus/pci/devices"))[:512]
    except OSError:
        return False
    for d in devs:
        try:
            data = read_file(sys_path("/sys/bus/pci/devices/%s/class" % d), 64, follow=True)
        except Refused:
            continue
        if data and data.strip().lower().startswith(b"0x0c00"):     # IEEE 1394 controller
            return True
    return False


@check
def check_firewire():
    cid, cat, title = "firewire", "harden", "FireWire"
    why = ("A FireWire port lets a plugged-in device read memory directly, which can be used to "
           "steal data from a locked laptop. Few machines still have one.")
    text = _modprobe_text()
    if re.search(r"(?m)^[ \t]*(blacklist|install)[ \t]+(ohci1394|firewire[-_]ohci|firewire-core)\b", text):
        return result(cid, cat, title, "pass", "Turned off.", why, weight=0)
    if not _has_firewire_port():
        return result(cid, cat, title, "pass", "This machine has no FireWire port.", why, weight=0)
    return result(cid, cat, title, "info", "This machine has a FireWire port and its driver can load.", why,
                  fix=fix("terminal", "firewire-off", "Turn off"), weight=0)


@check
def check_llmnr():
    cid, cat, title = "llmnr", "harden", "LLMNR name lookups"
    why = ("LLMNR lets any machine on the local network answer when your laptop looks up a name. "
           "Attackers on shared Wi-Fi use it to pose as servers and capture login hashes.")
    if systemctl("is-active", "systemd-resolved.service") != "active":
        return result(cid, cat, title, "na", "systemd-resolved is not running.", why, weight=2)
    value = _resolved_config().get("LLMNR", "yes").lower()
    if value in ("no", "false", "0", "off"):
        return result(cid, cat, title, "pass", "LLMNR is off.", why, weight=2)
    return result(cid, cat, title, "warn", "LLMNR is on (LLMNR=%s)." % clean(value, 20), why,
                  fix=fix("terminal", "llmnr-off", "Turn LLMNR off"), weight=2)


def _sshd_effective():
    """First-obtained-value semantics: drop-ins (Include at the top on Arch), then main."""
    files = conf_d(sys_path("/etc/ssh/sshd_config.d")) + [sys_path("/etc/ssh/sshd_config")]
    seen = {}
    for p in files:
        try:
            text = read_text(p) or ""
        except Refused:
            continue
        for raw in text.splitlines():
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.split(None, 1)
            key = parts[0].lower()
            if key == "match":
                break
            if len(parts) == 2 and key not in seen:
                seen[key] = parts[1].strip().lower()
    return seen


@check
def check_ssh_server():
    cid, cat, title = "ssh-server", "harden", "SSH server"
    why = ("An SSH server lets other machines log in to this one. If you do not use it, it should be off; "
           "if you do, it should accept keys only and never a direct root login.")
    active = systemctl("is-active", "sshd.service") == "active"
    enabled = systemctl("is-enabled", "sshd.service") == "enabled"
    if not active and not enabled:
        return result(cid, cat, title, "pass", "The SSH server is off.", why, weight=2)
    cfg = _sshd_effective()
    root_login = cfg.get("permitrootlogin", "prohibit-password")
    password = cfg.get("passwordauthentication", "yes")
    kbd = cfg.get("kbdinteractiveauthentication", "yes")
    detail = "sshd: %s, %s\nPermitRootLogin %s\nPasswordAuthentication %s\nKbdInteractiveAuthentication %s" % (
        "running" if active else "stopped", "starts at boot" if enabled else "manual",
        clean(root_login, 30), clean(password, 30), clean(kbd, 30))
    if root_login == "yes":
        return result(cid, cat, title, "fail", "SSH allows root to log in with a password.", why, detail,
                      fix("terminal", "sshd-harden", "Keys only, no root login"), weight=3)
    if password != "no" or kbd != "no":
        return result(cid, cat, title, "warn", "SSH accepts passwords, not just keys.", why, detail,
                      fix("terminal", "sshd-harden", "Keys only, no root login"), weight=2)
    return result(cid, cat, title, "pass", "SSH is on and accepts keys only.", why, detail, weight=2)


def _ssh_string(buf, pos):
    """One length-prefixed string from an OpenSSH key blob: (value, next_pos)."""
    if pos + 4 > len(buf):
        raise ValueError("truncated")
    n = int.from_bytes(buf[pos:pos + 4], "big")
    if pos + 4 + n > len(buf):
        raise ValueError("truncated")
    return buf[pos + 4:pos + 4 + n], pos + 4 + n


def _private_key_state(data):
    """Return (is_private_key, encrypted: True/False/None, kind)."""
    text = data.decode("ascii", "replace")
    if "-----BEGIN OPENSSH PRIVATE KEY-----" in text:
        body = text.split("-----BEGIN OPENSSH PRIVATE KEY-----", 1)[1].split("-----END", 1)[0]
        try:
            blob = b64decode("".join(body.split()), validate=False)
            magic = b"openssh-key-v1\x00"
            if not blob.startswith(magic):
                return True, None, "openssh"
            cipher, pos = _ssh_string(blob, len(magic))
            _kdf, pos = _ssh_string(blob, pos)
            _kdfopts, pos = _ssh_string(blob, pos)
            pos += 4                                  # number of keys
            pub, pos = _ssh_string(blob, pos)
            ktype, _ = _ssh_string(pub, 0)
            ktype = ktype.decode("ascii", "replace")
        except ValueError:
            return True, None, "openssh"
        if ktype.startswith("sk-"):
            return True, True, ktype                  # the secret half lives on a hardware key
        return True, cipher != b"none", ktype
    if "-----BEGIN ENCRYPTED PRIVATE KEY-----" in text:
        return True, True, "pkcs8"
    m = re.search(r"-----BEGIN ([A-Z0-9 ]*)PRIVATE KEY-----", text)
    if m:
        return True, "ENCRYPTED" in text.split("-----END", 1)[0], (m.group(1).strip().lower() or "pkcs8")
    return False, None, ""


def _open_home_dir(parts, create=False):
    """Walk from HOME with held descriptors; every component must be a real
    directory owned by us. Missing components are created 0700 if `create`."""
    fd = os.open(HOME, O_DIR)
    try:
        st = os.fstat(fd)
        if st.st_uid != os.geteuid():
            raise Refused("home directory is not owned by this account")
        for name in parts:
            if name in ("", ".", "..") or "/" in name:
                raise Refused("bad path component")
            try:
                nfd = os.open(name, O_DIR, dir_fd=fd)
            except FileNotFoundError:
                if not create:
                    raise
                os.mkdir(name, 0o700, dir_fd=fd)
                nfd = os.open(name, O_DIR, dir_fd=fd)
            except OSError as e:
                if e.errno in (errno.ELOOP, errno.ENOTDIR):
                    raise Refused("%s is not a real directory" % name)
                raise
            os.close(fd)
            fd = nfd
            st = os.fstat(fd)
            if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid():
                raise Refused("%s is not a directory owned by this account" % name)
        return fd
    except BaseException:
        os.close(fd)
        raise


def _scan_ssh_dir():
    """Return (dir_mode, [(name, mode, is_key, encrypted, kind)]) for ~/.ssh."""
    try:
        dfd = _open_home_dir([".ssh"])
    except FileNotFoundError:
        return None, []
    try:
        dmode = stat.S_IMODE(os.fstat(dfd).st_mode)
        rows = []
        with os.scandir(dfd) as it:
            names = sorted(e.name for e in it)[:64]
        for name in names:
            try:
                fd = os.open(name, O_READ | os.O_NOFOLLOW, dir_fd=dfd)
            except OSError:
                continue
            try:
                st = os.fstat(fd)
                if not stat.S_ISREG(st.st_mode) or st.st_size > SMALL_FILE_MAX:
                    continue
                data = _read_fd(fd, SMALL_FILE_MAX)
            except (OSError, Refused):
                continue
            finally:
                os.close(fd)
            is_key, enc, kind = _private_key_state(data)
            rows.append((name, stat.S_IMODE(st.st_mode), is_key, enc, kind))
        return dmode, rows
    finally:
        os.close(dfd)


@check
def check_ssh_keys():
    cid, cat, title = "ssh-keys", "harden", "SSH keys"
    why = ("Your SSH private keys are the keys to every server and Git host you use. They should be "
           "readable only by you and protected by a passphrase, so a stolen copy is useless.")
    try:
        dmode, rows = _scan_ssh_dir()
    except Refused as e:
        return result(cid, cat, title, "warn", "~/.ssh is not a plain private folder: %s" % e, why, weight=2)
    except OSError:
        return result(cid, cat, title, "unknown", "Could not read ~/.ssh.", why, weight=2)
    if dmode is None:
        return result(cid, cat, title, "na", "You have no ~/.ssh folder.", why, weight=2)
    keys = [r for r in rows if r[2]]
    loose = [r for r in keys if r[1] & 0o077]
    plain = [r for r in keys if r[3] is False]
    lines = ["~/.ssh is mode %03o" % dmode]
    for name, mode, _, enc, kind in keys:
        lines.append("%s (%s) mode %03o, %s" % (name, kind, mode,
                     "passphrase" if enc else ("no passphrase" if enc is False else "unknown")))
    detail = clean_block(lines)
    if dmode & 0o077 or loose:
        return result(cid, cat, title, "fail", "Other accounts can read your SSH folder or keys.", why, detail,
                      fix("helper", "ssh-perms", "Make them private"), weight=2)
    if plain:
        return result(cid, cat, title, "warn",
                      "%d private key%s ha%s no passphrase." % (len(plain), "" if len(plain) == 1 else "s",
                                                                "s" if len(plain) == 1 else "ve"),
                      why + " Add one with: ssh-keygen -p -f ~/.ssh/<key>", detail, fix=fix("terminal", "ssh-passphrase", "Add a passphrase"), weight=1)
    if not keys:
        return result(cid, cat, title, "pass", "No private keys in ~/.ssh.", why, detail, weight=1)
    return result(cid, cat, title, "pass", "Your SSH keys are private and passphrase-protected.", why, detail, weight=1)


@check
def check_gnupg():
    cid, cat, title = "gnupg", "harden", "GnuPG folder"
    why = "GnuPG keeps your private signing and encryption keys here; only you should be able to read it."
    try:
        fd = _open_home_dir([".gnupg"])
    except FileNotFoundError:
        return result(cid, cat, title, "na", "You have no ~/.gnupg folder.", why, weight=1)
    except Refused as e:
        return result(cid, cat, title, "warn", "~/.gnupg is not a plain private folder: %s" % e, why, weight=1)
    try:
        mode = stat.S_IMODE(os.fstat(fd).st_mode)
    finally:
        os.close(fd)
    if mode & 0o077:
        return result(cid, cat, title, "warn", "~/.gnupg is readable by other accounts (mode %03o)." % mode, why,
                      fix=fix("helper", "gnupg-perms", "Make it private"), weight=1)
    return result(cid, cat, title, "pass", "~/.gnupg is private.", why, weight=1)


def _shell_json_lock():
    for path in (home_path(".config", "omarchy", "shell.json"),
                 sys_path("/usr/share/omarchy/config/omarchy/shell.json")):
        try:
            text = read_text(path, FILE_MAX, follow=True)
        except Refused:
            continue
        if text is None:
            continue
        try:
            data = json.loads(text)
        except ValueError:
            return None, path
        idle = data.get("idle") if isinstance(data, dict) else None
        lock = idle.get("lock") if isinstance(idle, dict) else None
        if isinstance(lock, bool) or not isinstance(lock, (int, float)):
            return 0, path
        return int(lock), path
    return None, ""


@check
def check_screen_lock():
    cid, cat, title = "screen-lock", "harden", "Automatic screen lock"
    why = ("If you walk away from an unlocked laptop, anyone nearby can use your accounts. "
           "Locking after a few idle minutes closes that gap.")
    if exists(home_path(".local", "state", "omarchy", "indicators", "stay-awake")):
        return result(cid, cat, title, "warn", "Stay Awake is on, so the screen will not lock by itself.", why,
                      fix=fix("terminal", "allow-idle", "Turn Stay Awake off"), weight=2)
    lock_fix = fix("terminal", "screen-lock-default", "Lock after 5 minutes")
    lock, path = _shell_json_lock()
    if lock is None:
        return result(cid, cat, title, "unknown", "Could not read the idle settings.", why, weight=2)
    if lock <= 0:
        return result(cid, cat, title, "warn", "The screen never locks by itself.", why,
                      "idle.lock is off in shell.json", lock_fix, weight=2)
    minutes = lock / 60.0
    if lock > 900:
        return result(cid, cat, title, "warn", "The screen locks only after %d minutes idle." % round(minutes),
                      why, "idle.lock = %d seconds" % lock, lock_fix, weight=2)
    return result(cid, cat, title, "pass", "The screen locks after %s idle." % (
        "%d minutes" % round(minutes) if lock >= 120 else "%d seconds" % lock), why, weight=2)


def _rdev(path):
    return os.stat(path).st_rdev


def _root_device_chain():
    """Walk sysfs from the device under / and report dm-crypt anywhere below it."""
    try:
        text = read_text(sys_path("/proc/self/mountinfo"))
    except Refused:
        return None
    src = ""
    for line in (text or "").splitlines():
        parts = line.split()
        if len(parts) > 9 and parts[4] == "/":
            try:
                sep = parts.index("-")
                src = parts[sep + 2]
            except (ValueError, IndexError):
                continue
    if not src.startswith("/dev/"):
        return None
    try:
        rdev = _rdev(sys_path(src))
    except OSError:
        return None
    start = "%d:%d" % (os.major(rdev), os.minor(rdev))
    todo, seen = [start], set()
    while todo and len(seen) < 16:
        majmin = todo.pop()
        if majmin in seen:
            continue
        seen.add(majmin)
        base = sys_path("/sys/dev/block/" + majmin)
        try:
            uuid = (read_text(base + "/dm/uuid", 4096, follow=True) or "").strip()
        except Refused:
            uuid = ""
        if uuid.startswith("CRYPT-"):
            return True
        for slave in list_dir(base + "/slaves", 16):
            try:
                dev = (read_text(base + "/slaves/" + slave + "/dev", 64, follow=True) or "").strip()
            except Refused:
                dev = ""
            if re.fullmatch(r"\d+:\d+", dev):
                todo.append(dev)
    return False


@check
def check_disk_encryption():
    cid, cat, title = "disk-encryption", "harden", "Disk encryption"
    why = ("With full-disk encryption a lost or stolen laptop gives away nothing. Omarchy turns it on "
           "during install; it cannot be added later without reinstalling.")
    enc = _root_device_chain()
    if enc is None:
        return result(cid, cat, title, "unknown", "Could not tell how the system disk is set up.", why, weight=3)
    if enc:
        return result(cid, cat, title, "pass", "The system disk is encrypted (LUKS).", why, weight=3)
    return result(cid, cat, title, "warn", "The system disk is not encrypted. Only a reinstall can change this, "
                  "so mark it as reviewed if you accept that.", why, weight=3)


@check
def check_secure_boot():
    cid, cat, title = "secure-boot", "harden", "Secure Boot"
    why = ("Secure Boot makes the firmware refuse a tampered bootloader or kernel. Omarchy boots with "
           "Limine and leaves it off by default; turning it on needs your own signing keys (sbctl).")
    if not exists(sys_path("/sys/firmware/efi")):
        return result(cid, cat, title, "na", "This machine boots in legacy BIOS mode.", why, weight=0)
    path = sys_path("/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c")
    try:
        data = read_file(path, 64)
    except Refused:
        data = None
    if not data:
        return result(cid, cat, title, "unknown", "Could not read the Secure Boot state.", why, weight=0)
    if data[-1] == 1:
        return result(cid, cat, title, "pass", "Secure Boot is on.", why, weight=0)
    return result(cid, cat, title, "na", "Off, as Omarchy ships it. Setting it up is for experienced users, "
                  "since a mistake can stop the computer starting.", why, weight=0)


def _running_kernel():
    return os.uname().release


@check
def check_restart():
    cid, cat, title = "restart-needed", "harden", "Restart after updates"
    why = ("Kernel updates, which carry many security fixes, only take effect after a restart. Until then "
           "the computer keeps running the old kernel, holes included.")
    mods = sys_path("/usr/lib/modules")
    rel = _running_kernel()
    if not os.path.isdir(mods) or not re.fullmatch(r"[A-Za-z0-9._+-]{1,100}", rel):
        return result(cid, cat, title, "na", "Could not tell which kernel is installed.", why, weight=1)
    if os.path.isdir(os.path.join(mods, rel)):
        return result(cid, cat, title, "pass", "Running the newest installed kernel.", why, weight=1)
    return result(cid, cat, title, "warn", "A newer kernel is installed. Restart to start using it.", why,
                  fix=fix("terminal", "restart", "Restart now"), weight=1)


@check
def check_faillock():
    cid, cat, title = "login-lockout", "harden", "Wrong-password lockout"
    why = ("After a number of wrong passwords the account is locked for a while, which slows down "
           "anyone guessing at the keyboard or lock screen.")
    deny, unlock = None, None
    try:
        text = read_text(sys_path("/etc/pam.d/system-auth"))
        if text is None:
            return result(cid, cat, title, "na", "This system has no /etc/pam.d/system-auth.", why, weight=1)
        if "pam_faillock.so" not in text:
            return result(cid, cat, title, "warn", "Wrong passwords never lock the account.", why, weight=1)
        for line in text.splitlines():
            if "pam_faillock.so" in line and not line.lstrip().startswith("#"):
                m = re.search(r"\bdeny=(\d+)", line)
                if m:
                    deny = int(m.group(1))
                m = re.search(r"\bunlock_time=(\d+)", line)
                if m:
                    unlock = int(m.group(1))
        conf = parse_kv(read_text(sys_path("/etc/security/faillock.conf")) or "")
    except Refused:
        return result(cid, cat, title, "unknown", "Could not read the login settings.", why, weight=1)
    if deny is None and conf.get("deny", "").isdigit():
        deny = int(conf["deny"])
    if unlock is None and conf.get("unlock_time", "").isdigit():
        unlock = int(conf["unlock_time"])
    deny = 3 if deny is None else deny
    unlock = 600 if unlock is None else unlock
    if deny == 0:
        return result(cid, cat, title, "warn", "Wrong passwords never lock the account.", why, weight=1)
    return result(cid, cat, title, "pass",
                  "After %d wrong passwords the account locks for %d seconds." % (deny, unlock), why, weight=1)


@check
def check_passwordless_sudo():
    cid, cat, title = "passwordless-sudo", "harden", "Passwordless sudo"
    why = ("While passwordless sudo is on, any program you run can silently become root. "
           "Omarchy offers it as a convenience for a limited time; keep it off when you do not need it.")
    tool = find_tool("omarchy-sudo-passwordless")
    if not tool:
        return result(cid, cat, title, "na", "Omarchy's passwordless-sudo command is not installed.", why, weight=3)
    rc, _ = run([tool, "--active"], timeout=6, limit=4096)
    if rc is None:
        return result(cid, cat, title, "unknown", "Could not check passwordless sudo.", why, weight=3)
    if rc == 0:
        return result(cid, cat, title, "fail", "Passwordless sudo is on.", why,
                      fix=fix("terminal", "sudo-passwordless-off", "Turn it off"), weight=3)
    return result(cid, cat, title, "pass", "sudo asks for your password.", why, weight=3)


@check
def check_docker_group():
    cid, cat, title = "docker-group", "harden", "Docker group"
    why = ("Membership of the docker group is the same as having root without a password: any program "
           "you run can start a container that mounts the whole disk.")
    try:
        text = read_text(sys_path("/etc/group")) or ""
    except Refused:
        return result(cid, cat, title, "unknown", "Could not read /etc/group.", why, weight=2)
    for line in text.splitlines():
        parts = line.split(":")
        if len(parts) >= 4 and parts[0] == "docker":
            if USER and USER in parts[3].split(","):
                return result(cid, cat, title, "warn", "You are in the docker group (sudoless Docker).", why,
                              fix=fix("terminal", "docker-group-off", "Leave the docker group"), weight=2)
    return result(cid, cat, title, "pass", "You are not in the docker group.", why, weight=2)


